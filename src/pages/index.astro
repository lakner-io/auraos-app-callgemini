---
// CallGemini — voice-first chat with Gemini Live. The backend WS bridge lives in
// src/server/callBridge.mjs (attached in astro.config.mjs); this page is the UI
// shell. The browser controller is inlined in the <script> below ON PURPOSE:
// the shell proxy only rewrites `/@fs|/@vite|/@id|/node_modules` imports inside
// served JS, NOT app-authored `/src/...` imports — so a cross-file
// `import '../client/call.js'` would 404 in the iframe and no handlers attach.
// Keeping the controller in one processed module avoids that `/src/` sub-import.
const hasEnvKey = !!process.env.GEMINI_API_KEY;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CallGemini</title>
</head>
<body>
  <div class="cg-app" data-role="app" data-sidebar="closed" data-view="chat">
    <!-- Conversations drawer (overlay) + backdrop -->
    <aside class="cg-sidebar" data-role="sidebar" aria-label="Conversations">
      <button class="btn new-chat-btn" data-action="new-chat" type="button"><span data-licon="plus"></span> New chat</button>
      <div class="conv-list" data-role="conv-list"></div>
    </aside>
    <div class="cg-backdrop" data-role="sidebar-backdrop"></div>

    <!-- MCP servers drawer (right overlay): per-conversation ON/OFF + Skip -->
    <aside class="cg-mcpbar" data-role="mcpbar" aria-label="MCP servers">
      <div class="mcpbar-head">
        <span class="mcpbar-title">MCP servers</span>
        <div class="mcpbar-head-actions">
          <button class="icon-btn" data-action="mcpbar-info" type="button" aria-label="How this works" aria-expanded="false" title="How this works"><span data-licon="info"></span></button>
          <button class="icon-btn" data-action="mcpbar-close" type="button" aria-label="Close"><span data-licon="x"></span></button>
        </div>
        <!-- Info popover: toggled by the (i) button, closed by clicking anywhere else. -->
        <div class="mcpbar-info" data-role="mcpbar-info" data-open="false" role="note">
          <p>Per conversation.</p>
          <p><strong>ON/OFF</strong> decides what Gemini can see (changing it re-dials a live call).</p>
          <p><strong>Skip</strong> keeps the tools visible but answers every call with “skipped”.</p>
          <p><strong>Temporary</strong> servers are added by other apps through the CallGemini MCP server.</p>
        </div>
      </div>
      <div class="mcp-toggle-list" data-role="mcp-toggle-list"></div>
      <button class="btn btn-ghost btn-sm" data-action="mcpbar-settings" type="button">Manage servers…</button>
    </aside>

    <header class="cg-header">
      <div class="cg-header-left">
        <button class="icon-btn" data-action="toggle-sidebar" type="button" aria-label="Conversations" title="Conversations"><span data-licon="menu"></span></button>
        <div class="cg-title">
          <span class="cg-logo">CG</span>
          <span>CallGemini</span>
        </div>
      </div>
      <div class="cg-header-right">
        <span class="status-pill vad-pill" data-role="vad-badge" data-kind="none"></span>
        <button class="status-pill mcp-pill" data-action="toggle-mcpbar" data-role="mcp-badge" data-empty="true" type="button"
                title="MCP servers for this conversation" aria-label="MCP servers"><span data-licon="plug"></span><span data-role="mcp-badge-text">0/0</span></button>
        <span class="status-pill" data-role="status" data-state="idle">Idle</span>
      </div>
    </header>

    <main class="cg-transcript" data-role="transcript">
      <div class="cg-empty" data-role="empty">
        <p class="cg-empty-title">Press <strong>Call</strong> to talk to Gemini.</p>
        <p class="cg-empty-sub">The conversation is transcribed here live. Configure your API key and MCP tools with the ⚙ button.</p>
      </div>
    </main>

    <form class="cg-textbar" data-form="text">
      <input class="text-input" data-role="text-input" type="text"
             placeholder="Type a message (optional)…" autocomplete="off" />
      <button class="btn btn-ghost" type="submit">Send</button>
    </form>

    <div class="cg-controls">
      <button class="btn btn-icon" data-action="settings" type="button" title="Settings" aria-label="Settings"><span data-licon="settings"></span></button>
      <button class="btn call-btn" data-action="toggle-call" data-active="false" type="button">Call</button>
      <button class="btn btn-ghost mute-btn" data-action="mute" data-muted="false" type="button" disabled title="Mute microphone" aria-label="Mute microphone" aria-pressed="false"><span class="mute-icon" data-role="mute-icon"></span><span class="mute-label" data-role="mute-label">Mute</span></button>
      <div class="vol-ctl" data-role="vol-ctl" data-overdrive="false" title="Playback volume — past 100% is overdrive">
        <button class="vol-icon vol-mute-btn" data-action="speaker-mute" type="button" title="Silence speaker" aria-label="Silence speaker" aria-pressed="false"><span data-role="vol-icon"></span></button>
        <input class="vol-slider" data-role="vol-slider" type="range" min="0" max="300" step="5" value="100"
               aria-label="Playback volume (0–300%)" />
        <span class="vol-val" data-role="vol-val">100%</span>
      </div>
    </div>

    <!-- Settings view: a full-window page over the chat, NOT a separate route —
         the call (WS, mic, AudioContexts) lives in this document and must keep
         running while the user edits. The chat underneath is hidden via CSS. -->
    <section class="cg-settings" data-role="settings-view" data-tab="roles" aria-label="Settings">
      <header class="settings-head">
        <button class="icon-btn" data-action="settings-close" type="button" aria-label="Back to chat" title="Back to chat"><span data-licon="arrow-left"></span></button>
        <h2 class="settings-title">Settings</h2>
        <span class="status-pill" data-role="settings-status" data-state="idle"></span>
      </header>

      <!-- Profile = the AI setup (model, voice, roles, integrations). Global
           settings (key, audio, languages) are shared by every profile. -->
      <div class="settings-profilebar">
        <label class="profilebar-label" for="cg-profile-select">Profile</label>
        <select class="field-input profile-select" id="cg-profile-select" data-field="profile"></select>
        <div class="menu-anchor">
          <button class="icon-btn" data-action="menu-toggle" data-menu="profile" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Profile actions" title="Profile actions"><span data-licon="ellipsis"></span></button>
          <div class="settings-menu" data-menu-panel="profile" data-open="false" role="menu">
            <button class="menu-item" data-action="profile-new" type="button" role="menuitem">New profile</button>
            <button class="menu-item" data-action="profile-duplicate" type="button" role="menuitem">Duplicate</button>
            <button class="menu-item" data-action="profile-rename" type="button" role="menuitem">Rename</button>
            <button class="menu-item menu-item-danger" data-action="profile-delete" type="button" role="menuitem">Delete</button>
          </div>
        </div>
      </div>
      <div class="inline-bar" data-inline="profile" data-mode="none">
        <span class="inline-bar-msg"></span>
        <input class="field-input inline-bar-input" type="text" aria-label="Name" />
        <button class="btn btn-ghost btn-sm" data-action="inline-cancel" type="button">Cancel</button>
        <button class="btn btn-sm inline-bar-ok" data-action="inline-ok" type="button">OK</button>
      </div>

      <nav class="settings-tabs" role="tablist" aria-label="Settings sections">
        <button class="settings-tab" id="cg-tab-roles" data-tab="roles" role="tab" type="button" aria-controls="cg-panel-roles">Roles</button>
        <button class="settings-tab" id="cg-tab-model" data-tab="model" role="tab" type="button" aria-controls="cg-panel-model">Model &amp; voice</button>
        <button class="settings-tab" id="cg-tab-integrations" data-tab="integrations" role="tab" type="button" aria-controls="cg-panel-integrations">Integrations</button>
        <span class="settings-tabs-sep" aria-hidden="true"></span>
        <button class="settings-tab" id="cg-tab-global" data-tab="global" role="tab" type="button" aria-controls="cg-panel-global">Global</button>
      </nav>

      <div class="settings-body">
        <section class="settings-panel" id="cg-panel-roles" data-panel="roles" role="tabpanel" aria-labelledby="cg-tab-roles">
          <div class="roles-layout">
            <div class="roles-nav">
              <div class="roles-toolbar">
                <select class="field-input role-select" data-field="role" aria-label="Role"></select>
                <button class="btn btn-ghost btn-sm" data-action="role-new" type="button"><span data-licon="plus"></span> Role</button>
              </div>
              <div class="roles-list" data-role="roles-list" aria-label="Roles"></div>
            </div>

            <div class="roles-editor">
              <div class="inline-bar" data-inline="role" data-mode="none">
                <span class="inline-bar-msg"></span>
                <input class="field-input inline-bar-input" type="text" aria-label="Name" />
                <button class="btn btn-ghost btn-sm" data-action="inline-cancel" type="button">Cancel</button>
                <button class="btn btn-sm inline-bar-ok" data-action="inline-ok" type="button">OK</button>
              </div>

              <div class="role-empty" data-role="role-empty">
                <p>No prompt roles in this profile — Gemini uses its default behavior.</p>
                <button class="btn btn-sm" data-action="role-new" type="button"><span data-licon="plus"></span> New role</button>
              </div>

              <div class="role-card" data-role="role-card">
                <div class="role-card-head">
                  <span class="role-name" data-role="role-name"></span>
                  <span class="badge badge-on" data-role="role-active-badge">Active</span>
                  <button class="btn btn-ghost btn-sm" data-action="role-activate" type="button">Make active</button>
                  <div class="menu-anchor">
                    <button class="icon-btn" data-action="menu-toggle" data-menu="role" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Role actions" title="Role actions"><span data-licon="ellipsis"></span></button>
                    <div class="settings-menu" data-menu-panel="role" data-open="false" role="menu">
                      <button class="menu-item" data-action="role-rename" type="button" role="menuitem">Rename</button>
                      <button class="menu-item" data-action="role-duplicate" type="button" role="menuitem">Duplicate</button>
                      <button class="menu-item menu-item-danger" data-action="role-delete" type="button" role="menuitem">Delete</button>
                    </div>
                  </div>
                </div>

                <div class="version-row">
                  <label class="version-pick">
                    <span class="field-label">Version</span>
                    <select class="field-input version-select" data-field="version"></select>
                  </label>
                  <span class="badge" data-role="version-state"></span>
                  <span class="version-actions">
                    <button class="btn btn-ghost btn-sm" data-action="version-new" type="button"><span data-licon="copy"></span> New version</button>
                    <button class="btn btn-sm" data-action="version-use" type="button"><span data-licon="check"></span> Use this version</button>
                  </span>
                </div>

                <textarea class="field-input role-text" data-field="roleText" rows="12" placeholder="How Gemini should behave in this role"></textarea>
                <span class="field-hint" data-role="version-hint"></span>
              </div>
            </div>
          </div>
        </section>

        <section class="settings-panel" id="cg-panel-model" data-panel="model" role="tabpanel" aria-labelledby="cg-tab-model">
          <label class="field" data-role="model-field">
            <span class="field-label">Model</span>
            <select class="field-input" data-field="modelPreset"></select>
            <input class="field-input model-custom" data-field="model" type="text" placeholder="custom model id" />
          </label>

          <label class="field">
            <span class="field-label">Voice</span>
            <select class="field-input" data-field="voice"></select>
          </label>
        </section>

        <section class="settings-panel" id="cg-panel-integrations" data-panel="integrations" role="tabpanel" aria-labelledby="cg-tab-integrations">
          <label class="field">
            <span class="field-label">ACP shadow address</span>
            <input class="field-input" data-field="acpAddress" type="text" placeholder="/api/... or ws://host/path (empty = off)" />
            <button class="btn btn-ghost btn-sm" data-action="acp-discover" type="button">Discover</button>
            <span class="field-hint">ACP agent endpoint that silently receives the live call transcript as shadow context. Applies to your next call.</span>
          </label>

          <div class="field">
            <span class="field-label">MCP servers (remote HTTP / SSE)</span>
            <div class="mcp-list" data-role="mcp-list"></div>
            <button class="btn btn-ghost btn-sm" data-action="mcp-add" type="button">+ Add MCP server</button>
          </div>
        </section>

        <section class="settings-panel" id="cg-panel-global" data-panel="global" role="tabpanel" aria-labelledby="cg-tab-global">
          <p class="panel-note">Shared by all profiles.</p>
          <label class="field">
            <span class="field-label">Gemini API key</span>
            <input class="field-input" data-field="apiKey" type="password" placeholder={hasEnvKey ? 'Using GEMINI_API_KEY from Context — override here' : 'Paste your AI Studio key'} />
          </label>

          <div class="field">
            <span class="field-label">Languages</span>
            <div class="lang-chips" data-role="lang-chips"></div>
            <span class="field-hint">Tell Gemini which languages you speak so it understands you better. Any = auto-detect. Applies to your next call.</span>
          </div>

          <label class="field">
            <span class="field-label">Microphone</span>
            <select class="field-input" data-field="micDevice"></select>
          </label>

          <label class="field">
            <span class="field-label">Audio output</span>
            <select class="field-input" data-field="outputDevice"></select>
            <span class="field-hint">Which speaker/headset the call plays through. Applies to your next call.</span>
          </label>

          <label class="field">
            <span class="field-label">Noise reduction</span>
            <select class="field-input" data-field="noiseReduction"></select>
            <span class="field-hint">AI removes keyboard/background noise before speech detection. Applies to your next call.</span>
          </label>

          <label class="field">
            <span class="field-label">Voice detection</span>
            <select class="field-input" data-field="vadMode"></select>
            <span class="field-hint">Server = Gemini detects your speech (simple). Browser = local Silero VAD signals it explicitly — fastest, downloads ~16 MB once. Applies to your next call.</span>
          </label>

          <label class="field">
            <span class="field-label">Responsiveness</span>
            <select class="field-input" data-field="responsiveness"></select>
            <span class="field-hint">How soon you count as “done talking” (both detection modes). Lower = faster replies, but may cut you off mid-pause. Applies to your next call.</span>
          </label>
        </section>
      </div>

      <!-- Leaving with unsaved edits flips the footer into a discard prompt
           instead of silently dropping them (iframes may block confirm()). -->
      <footer class="settings-foot" data-confirm="false">
        <span class="settings-foot-msg">Discard unsaved changes?</span>
        <button class="btn btn-ghost" data-action="settings-close" type="button">Cancel</button>
        <button class="btn call-btn" data-action="settings-save" type="button">Save</button>
        <button class="btn btn-ghost" data-action="settings-keep" type="button">Keep editing</button>
        <button class="btn btn-danger" data-action="settings-discard" type="button">Discard</button>
      </footer>
    </section>
  </div>

  <script define:vars={{ hasEnvKey }} is:inline>
    window.GEMINI_API_KEY_PRESENT = hasEnvKey;
  </script>
  <script>
    // ── CallGemini browser controller (inlined — see frontmatter note) ──────
    // Owns the voice call end-to-end: mic capture → 16 kHz PCM over the WS,
    // 24 kHz PCM playback, live transcript rendering, tool chips, settings, and
    // config persistence. Elements are found by data-* hooks, styled by class;
    // transcript rows are created here at runtime.
    import { createElement as lucideEl, Menu, Settings, X, Trash2, Plus, Plug, Mic, MicOff, Info, Volume2, VolumeX, ArrowLeft, Ellipsis, Copy, Check } from 'lucide';
    import { createCallAudio } from '../client/callAudio.mjs';

    // Lucide SVG icons (stroke=currentColor → inherit the button's theme color).
    const LUCIDE = { menu: Menu, settings: Settings, x: X, 'trash-2': Trash2, plus: Plus, plug: Plug, mic: Mic, 'mic-off': MicOff, info: Info, 'volume-2': Volume2, 'volume-x': VolumeX, 'arrow-left': ArrowLeft, ellipsis: Ellipsis, copy: Copy, check: Check };
    function icon(node, size = 18) {
      const el = lucideEl(node);
      el.setAttribute('width', String(size));
      el.setAttribute('height', String(size));
      return el;
    }
    /** Replace every <span data-licon="name"> placeholder with its SVG. */
    function mountIcons(root = document) {
      root.querySelectorAll('[data-licon]').forEach((el) => {
        const node = LUCIDE[el.dataset.licon];
        if (node && !el.firstChild) el.appendChild(icon(node));
      });
    }

    const APP_ID = 'io.lakner.callgemini';
    const KV_URL = `/api/kv/app/${APP_ID}/config`; // absolute → shell KV route, app identified by Referer

    const DEFAULTS = {
      apiKey: '',
      model: 'gemini-2.5-flash-native-audio-preview-12-2025',
      voiceName: 'Kore',
      systemInstruction: '',
      responsiveness: 'balanced', // snappy | balanced | relaxed — end-of-speech window
      vadMode: 'server',          // 'server' (automatic detection) | 'browser' (local Silero VAD)
      volume: 100,                // playback volume %, up to 300 (overdrive past 100)
      noiseReduction: 'ai',       // 'ai' (RNNoise + browser filters) | 'browser' (filters only)
      micDeviceId: '',            // '' = system default input
      outputDeviceId: '',         // '' = system default output
      languages: [],              // BCP-47 hints for input understanding; [] = auto-detect
      acpAddress: '',             // ACP endpoint for shadow transcript sync; '' = off
      mcpServers: [],             // [{ url, transport, behavior? }] — behavior 'non-blocking' (default) | 'blocking'
    };
    // BCP-47 language hints — German & English first, then popular ones.
    const LANGUAGES = [
      { code: 'de-DE', label: 'Deutsch' },
      { code: 'en-US', label: 'English' },
      { code: 'es-ES', label: 'Español' },
      { code: 'fr-FR', label: 'Français' },
      { code: 'it-IT', label: 'Italiano' },
      { code: 'pt-BR', label: 'Português' },
      { code: 'nl-NL', label: 'Nederlands' },
      { code: 'pl-PL', label: 'Polski' },
      { code: 'ru-RU', label: 'Русский' },
      { code: 'tr-TR', label: 'Türkçe' },
      { code: 'ar-XA', label: 'العربية' },
      { code: 'hi-IN', label: 'हिन्दी' },
      { code: 'zh-CN', label: '中文' },
      { code: 'ja-JP', label: '日本語' },
      { code: 'ko-KR', label: '한국어' },
    ];
    const NOISE_OPTS = [
      { value: 'ai', label: 'AI + Audio DSP (recommended)' },
      { value: 'browser', label: 'Audio DSP only' },
    ];
    const RESPONSIVENESS_OPTS = [
      { value: 'snappy', label: 'Snappy · 350ms' },
      { value: 'balanced', label: 'Balanced · 600ms' },
      { value: 'relaxed', label: 'Relaxed · 1000ms' },
    ];
    const RESPONSIVENESS_MS = { snappy: 350, balanced: 600, relaxed: 1000 };
    const MODEL_PRESETS = [
      { value: 'gemini-2.5-flash-native-audio-preview-12-2025', label: 'Native audio (expressive)' },
      { value: 'gemini-live-2.5-flash-preview', label: 'Half-cascade (fastest)' },
      { value: 'custom', label: 'Custom…' },
    ];
    const VAD_MODE_OPTS = [
      { value: 'server', label: 'Server (simple)' },
      { value: 'browser', label: 'Browser (Silero — fastest)' },
    ];
    const VOICES = ['Puck', 'Charon', 'Kore', 'Fenrir', 'Aoede', 'Leda', 'Orus', 'Zephyr'];

    // ── settings-store:begin ────────────────────────────────────────────────
    // Pure settings model (no DOM) — kept between these markers so a test can
    // extract and exercise it. KV value, schema 2:
    //   { schema: 2, global: {apiKey, audio…, languages}, activeProfileId,
    //     profiles: [{ id, name, model, voiceName, acpAddress, mcpServers,
    //                  activeRoleId, roles: [{ id, name, activeVersion,
    //                  versions: [{ n, text, createdAt }] }] }] }
    // A call still receives the flat `config` shape (resolveConfig), so the
    // server side is unchanged. Only the highest version n is editable.
    const PROFILE_KEYS = ['model', 'voiceName', 'acpAddress', 'mcpServers'];

    function uid(prefix) {
      try { return `${prefix}_${crypto.randomUUID()}`; }
      catch { return `${prefix}_${Date.now().toString(36)}${Math.random().toString(36).slice(2, 10)}`; }
    }

    function blankProfile(name, defaults) {
      return {
        id: uid('p'), name,
        model: defaults.model, voiceName: defaults.voiceName, acpAddress: '', mcpServers: [],
        activeRoleId: null, roles: [],
      };
    }

    function newRole(name, text = '') {
      return { id: uid('r'), name, activeVersion: 1, versions: [{ n: 1, text, createdAt: Date.now() }] };
    }

    const latestN = (role) => role.versions.reduce((m, v) => Math.max(m, v.n), 0);
    const versionOf = (role, n) => role.versions.find((v) => v.n === n) ?? null;
    const isFrozen = (role, n) => n !== latestN(role);
    const activeProfile = (store) => store.profiles.find((p) => p.id === store.activeProfileId) ?? store.profiles[0];
    const activeRole = (profile) => profile.roles.find((r) => r.id === profile.activeRoleId) ?? null;

    /** Copy `fromN`'s text (default: latest) into a new latest version; returns its n. */
    function addVersion(role, fromN) {
      const src = versionOf(role, fromN) ?? versionOf(role, latestN(role));
      const n = latestN(role) + 1;
      role.versions.push({ n, text: src?.text ?? '', createdAt: Date.now() });
      return n;
    }

    /** Deep copy with fresh ids (the active role follows its copy). */
    function duplicateProfile(profile, name) {
      const copy = JSON.parse(JSON.stringify(profile));
      copy.id = uid('p');
      copy.name = name;
      for (const r of copy.roles) {
        const fresh = uid('r');
        if (copy.activeRoleId === r.id) copy.activeRoleId = fresh;
        r.id = fresh;
      }
      return copy;
    }

    /** `base`, or `base 2`, `base 3`… — whichever is not taken. */
    function uniqueName(base, taken) {
      const names = new Set(taken);
      if (!names.has(base)) return base;
      for (let i = 2; ; i += 1) if (!names.has(`${base} ${i}`)) return `${base} ${i}`;
    }

    /** Any stored value (schema 2, the old flat config, or nothing) → a valid schema-2 store. */
    function migrateStore(value, defaults) {
      const globalDefaults = { ...defaults };
      for (const k of [...PROFILE_KEYS, 'systemInstruction']) delete globalDefaults[k];
      const obj = value && typeof value === 'object' ? value : {};

      if (obj.schema === 2 && Array.isArray(obj.profiles) && obj.profiles.length) {
        const store = JSON.parse(JSON.stringify(obj));
        store.global = { ...globalDefaults, ...(store.global ?? {}) };
        for (const p of store.profiles) {
          p.roles = (Array.isArray(p.roles) ? p.roles : []).filter((r) => Array.isArray(r?.versions) && r.versions.length);
          for (const r of p.roles) if (!versionOf(r, r.activeVersion)) r.activeVersion = latestN(r);
          if (!p.roles.some((r) => r.id === p.activeRoleId)) p.activeRoleId = p.roles[0]?.id ?? null;
          if (!Array.isArray(p.mcpServers)) p.mcpServers = [];
        }
        if (!store.profiles.some((p) => p.id === store.activeProfileId)) store.activeProfileId = store.profiles[0].id;
        return store;
      }

      // Old flat config: profile fields → "Default" profile, the rest stays global
      // (unknown keys too — they keep reaching the call through resolveConfig).
      const flat = { ...defaults, ...obj };
      const { systemInstruction, model, voiceName, acpAddress, mcpServers, schema, ...global } = flat;
      const profile = {
        ...blankProfile('Default', defaults),
        model: model || defaults.model,
        voiceName: voiceName || defaults.voiceName,
        acpAddress: acpAddress ?? '',
        mcpServers: Array.isArray(mcpServers) ? mcpServers : [],
      };
      if (typeof systemInstruction === 'string' && systemInstruction.trim()) {
        const role = newRole('Default', systemInstruction);
        profile.roles.push(role);
        profile.activeRoleId = role.id;
      }
      return { schema: 2, global: { ...globalDefaults, ...global }, activeProfileId: profile.id, profiles: [profile] };
    }

    /** The flat config a call uses: global + active profile + active role's in-use version. */
    function resolveConfig(store, defaults) {
      const p = activeProfile(store);
      const r = activeRole(p);
      const v = r && (versionOf(r, r.activeVersion) ?? versionOf(r, latestN(r)));
      return {
        ...defaults,
        ...store.global,
        model: p.model || defaults.model,
        voiceName: p.voiceName || defaults.voiceName,
        acpAddress: p.acpAddress ?? '',
        mcpServers: Array.isArray(p.mcpServers) ? p.mcpServers : [],
        systemInstruction: v?.text ?? '',
      };
    }

    /** Stable serialization for "are there unsaved changes?" (key order, trims, defaults). */
    function canonicalStore(store) {
      const g = store.global ?? {};
      return JSON.stringify({
        global: Object.keys(g).sort().map((k) => [k,
          k === 'languages' ? [...(g[k] ?? [])].sort()
            : typeof g[k] === 'string' ? g[k].trim() : g[k]]),
        active: store.activeProfileId,
        profiles: store.profiles.map((p) => [
          p.id, p.name, p.model, p.voiceName, (p.acpAddress ?? '').trim(), p.activeRoleId,
          (p.mcpServers ?? []).filter((m) => m?.url).map((m) => [
            m.url.trim(), m.transport ?? 'http', m.behavior === 'blocking' ? 'blocking' : 'non-blocking',
          ]),
          p.roles.map((r) => [r.id, r.name, r.activeVersion, r.versions.map((v) => [v.n, (v.text ?? '').trim()])]),
        ]),
      });
    }
    // ── settings-store:end ──────────────────────────────────────────────────

    const $ = (sel, root = document) => root.querySelector(sel);

    const els = {
      appEl: $('[data-role="app"]'),
      sidebar: $('[data-role="sidebar"]'),
      backdrop: $('[data-role="sidebar-backdrop"]'),
      convList: $('[data-role="conv-list"]'),
      toggleSidebarBtn: $('[data-action="toggle-sidebar"]'),
      newChatBtn: $('[data-action="new-chat"]'),
      status: $('[data-role="status"]'),
      vadBadge: $('[data-role="vad-badge"]'),
      mcpBadge: $('[data-role="mcp-badge"]'),
      mcpBadgeText: $('[data-role="mcp-badge-text"]'),
      mcpbar: $('[data-role="mcpbar"]'),
      mcpToggleList: $('[data-role="mcp-toggle-list"]'),
      mcpbarClose: $('[data-action="mcpbar-close"]'),
      mcpbarInfoBtn: $('[data-action="mcpbar-info"]'),
      mcpbarInfo: $('[data-role="mcpbar-info"]'),
      mcpbarSettings: $('[data-action="mcpbar-settings"]'),
      transcript: $('[data-role="transcript"]'),
      callBtn: $('[data-action="toggle-call"]'),
      muteBtn: $('[data-action="mute"]'),
      volCtl: $('[data-role="vol-ctl"]'),
      volSlider: $('[data-role="vol-slider"]'),
      volVal: $('[data-role="vol-val"]'),
      speakerBtn: $('[data-action="speaker-mute"]'),
      volIconSlot: $('[data-role="vol-icon"]'),
      muteIcon: $('[data-role="mute-icon"]'),
      muteLabel: $('[data-role="mute-label"]'),
      settingsBtn: $('[data-action="settings"]'),
      textForm: $('[data-form="text"]'),
      textInput: $('[data-role="text-input"]'),
      settingsView: $('[data-role="settings-view"]'),
      settingsStatus: $('[data-role="settings-status"]'),
      settingsFoot: $('.settings-foot'),
      fApiKey: $('[data-field="apiKey"]'),
      fModel: $('[data-field="model"]'),
      fModelPreset: $('[data-field="modelPreset"]'),
      modelField: $('[data-role="model-field"]'),
      fVoice: $('[data-field="voice"]'),
      fMicDevice: $('[data-field="micDevice"]'),
      fOutputDevice: $('[data-field="outputDevice"]'),
      fVadMode: $('[data-field="vadMode"]'),
      fNoise: $('[data-field="noiseReduction"]'),
      langChips: $('[data-role="lang-chips"]'),
      fResponsiveness: $('[data-field="responsiveness"]'),
      profileSelect: $('[data-field="profile"]'),
      roleSelect: $('[data-field="role"]'),
      rolesList: $('[data-role="roles-list"]'),
      roleEmpty: $('[data-role="role-empty"]'),
      roleCard: $('[data-role="role-card"]'),
      roleName: $('[data-role="role-name"]'),
      roleActiveBadge: $('[data-role="role-active-badge"]'),
      roleActivate: $('[data-action="role-activate"]'),
      versionSelect: $('[data-field="version"]'),
      versionState: $('[data-role="version-state"]'),
      versionHint: $('[data-role="version-hint"]'),
      versionUse: $('[data-action="version-use"]'),
      fRoleText: $('[data-field="roleText"]'),
      settingsTabs: $('.settings-tabs'),
      fAcpAddress: $('[data-field="acpAddress"]'),
      acpDiscover: $('[data-action="acp-discover"]'),
      mcpList: $('[data-role="mcp-list"]'),
      mcpAdd: $('[data-action="mcp-add"]'),
      settingsSave: $('[data-action="settings-save"]'),
    };

    // `store` (profiles, roles, versions — see settings-store) is the source of
    // truth; `config` is its resolved flat view, which is what a call sends.
    let store = migrateStore(null, DEFAULTS);
    let config = resolveConfig(store, DEFAULTS);
    let pendingV1Backup = null; // old flat config, copied aside before the first schema-2 write
    let ws = null;
    let inCall = false;
    let muted = false;
    // Speaker silenced (playback gain 0, config.volume untouched so unsilence
    // restores it). Page-lifetime only: survives calls, not a reload.
    let speakerMuted = false;
    let activeConversationId = null; // null = new chat; set → resume on next call
    // Per-conversation MCP toggles (server URLs). Empty = all ON, nothing skipped.
    let mcpDisabled = new Set();
    let mcpSkipped = new Set();
    const mcpLive = new Map();       // url → last server-side report (tools / error), during a call
    // Temporary MCP servers of the active conversation (record field
    // mcpTemporary). Added/removed by other apps through the CallGemini MCP
    // server; the X button here removes one.
    let tempServers = [];
    let mcpPollTimer = null;         // refreshes tempServers while the drawer is open and no call runs
    let convRefreshTimer = null;
    let captureCtx = null;
    let captureStream = null;
    let callAudio = null;
    let playbackCtx = null;
    let playbackNode = null;
    let playbackGain = null; // fade stage for soft barge-in
    let volumeGain = null;   // user volume incl. overdrive (>1), limiter behind it
    let volSaveTimer = 0;    // debounce for persisting slider drags
    let underrunNoted = false; // one jitter systemLine per call, not per underrun
    let vadFailStreak = 0;     // consecutive VAD inference failures → live fallback
    let playbackEl = null;   // hidden <audio> sink — see startPlayback (AEC)
    let fading = false;      // softInterrupt re-entrancy guard
    let userLevel = 0;       // live RMS of mic / model audio → button glow
    let modelLevel = 0;
    let levelRaf = 0;
    let smoothedLevel = 0;
    let wsReconnecting = false; // browser-leg auto-reconnect in progress
    const activeBubbles = { user: null, model: null };
    const toolChips = new Map();

    async function loadConfig() {
      try {
        const res = await fetch(KV_URL);
        if (res.ok) {
          const { value } = await res.json();
          if (value && typeof value === 'object' && value.schema !== 2) pendingV1Backup = value;
          store = migrateStore(value, DEFAULTS);
          config = resolveConfig(store, DEFAULTS);
        }
      } catch { /* first run / offline — keep defaults */ }
    }

    async function saveConfig() {
      try {
        if (pendingV1Backup) {
          // One-time safety net: keep the pre-profiles config restorable.
          const backup = await fetch(`${KV_URL}-v1-backup`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ value: pendingV1Backup }),
          });
          if (!backup.ok) { console.error('[callgemini] v1 backup failed:', backup.status); return false; }
          pendingV1Backup = null;
        }
        const res = await fetch(KV_URL, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ value: store }),
        });
        if (!res.ok) { console.error('[callgemini] config save failed:', res.status); return false; }
        return true;
      } catch (err) {
        console.error('[callgemini] config save error:', err);
        return false;
      }
    }

    const STATUS_LABEL = {
      idle: 'Idle', connecting: 'Connecting…', live: 'Live', ended: 'Call ended', error: 'Error',
      reconnecting: 'Reconnecting…',
    };

    function setStatus(state, message) {
      const text = message ? `${STATUS_LABEL[state] ?? state} · ${message}` : (STATUS_LABEL[state] ?? state);
      // The settings header mirrors the pill so a live call stays visible.
      for (const pill of [els.status, els.settingsStatus]) {
        if (!pill) continue;
        pill.dataset.state = state;
        pill.textContent = text;
      }
    }

    const VAD_BADGE_LABEL = { silero: 'Silero VAD', energy: 'Energy VAD', rnnoise: 'RNNoise VAD', server: 'Server VAD' };
    /** Reflect the engine ACTUALLY in use this call (post-fallback), not the
     * Settings choice. `null` hides the badge (no call running). */
    function setVadBadge(kind) {
      if (!els.vadBadge) return;
      els.vadBadge.dataset.kind = kind ?? 'none';
      els.vadBadge.textContent = kind ? VAD_BADGE_LABEL[kind] : '';
    }

    function scrollDown() {
      if (els.transcript) els.transcript.scrollTop = els.transcript.scrollHeight;
    }

    function clearEmpty() {
      const empty = els.transcript?.querySelector('[data-role="empty"]');
      if (empty) empty.remove();
    }

    function createBubble(role) {
      clearEmpty();
      const row = document.createElement('div');
      row.className = 'msg-row';
      row.dataset.role = role;
      const bubble = document.createElement('div');
      bubble.className = 'msg-bubble';
      const txt = document.createElement('span');
      txt.className = 'msg-text';
      bubble.appendChild(txt);
      row.appendChild(bubble);
      els.transcript.appendChild(row);
      scrollDown();
      return { row, textEl: txt };
    }

    // Transcript batching: transcript WS events arrive many times per second
    // while Gemini speaks, and each DOM append + scrollHeight read forces a
    // reflow on the same thread that feeds the playback worklet. Coalesce all
    // text into one DOM write + one scroll per animation frame.
    const pendingText = { user: '', model: '' };
    let transcriptRaf = 0;

    function flushTranscript() {
      transcriptRaf = 0;
      let wrote = false;
      for (const role of ['user', 'model']) {
        if (!pendingText[role]) continue;
        if (!activeBubbles[role]) activeBubbles[role] = createBubble(role);
        activeBubbles[role].textEl.textContent += pendingText[role];
        pendingText[role] = '';
        wrote = true;
      }
      if (wrote) scrollDown();
    }

    function appendTranscript(role, text) {
      pendingText[role] += text;
      if (!transcriptRaf) transcriptRaf = requestAnimationFrame(flushTranscript);
    }

    function finalizeTurn() {
      // Land any batched text in the CURRENT bubbles before closing them.
      if (transcriptRaf) cancelAnimationFrame(transcriptRaf);
      flushTranscript();
      activeBubbles.user = null;
      activeBubbles.model = null;
    }

    function systemLine(text, kind = 'info') {
      clearEmpty();
      const row = document.createElement('div');
      row.className = 'sys-line';
      row.dataset.kind = kind;
      row.textContent = text;
      els.transcript.appendChild(row);
      scrollDown();
    }

    function toolChip(name, phase, error) {
      let chip = toolChips.get(name);
      if (!chip || phase === 'running') {
        chip = document.createElement('div');
        chip.className = 'tool-chip';
        els.transcript.appendChild(chip);
        toolChips.set(name, chip);
      }
      chip.dataset.phase = phase;
      chip.textContent = phase === 'running' ? `⚙ ${name}…` : (error ? `✗ ${name} — ${error}` : `✓ ${name}`);
      if (error) chip.dataset.error = 'true';
      scrollDown();
    }

    function wsUrl() {
      const id = window.AURA_INSTANCE_ID
        || document.querySelector('meta[name="aura-instance-id"]')?.content
        || APP_ID;
      const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
      return `${proto}//${location.host}/api/proxy/${id}/ws`;
    }

    function openWs() {
      return new Promise((resolve, reject) => {
        const sock = new WebSocket(wsUrl());
        sock.binaryType = 'arraybuffer';
        sock.addEventListener('open', () => resolve(sock));
        sock.addEventListener('error', (e) => reject(e));
        sock.addEventListener('message', onWsMessage);
        // A close while a call is live and no reconnect is already running is
        // a network drop, not a hang-up (endCall flips inCall to false BEFORE
        // its socket close fires) — try to resume instead of dying.
        sock.addEventListener('close', () => {
          if (!inCall || wsReconnecting || ws !== sock) return;
          reconnectWs();
        });
      });
    }

    function buildStartFrame() {
      return JSON.stringify({
        type: 'start',
        config: { ...config, vadMode: vadEngineKind ? 'browser' : 'server' },
        conversationId: activeConversationId,
        mcp: { disabled: [...mcpDisabled], skipped: [...mcpSkipped] },
        speakerMuted,
      });
    }

    /**
     * Browser-leg resilience: the audio pipeline stays alive; we re-dial the
     * app WS with backoff and re-`start` with the SAME conversationId — the
     * server re-seeds Gemini from the saved transcript (the existing resume
     * path), so the call continues instead of starting over.
     */
    async function reconnectWs() {
      wsReconnecting = true;
      setStatus('reconnecting');
      for (const delay of [500, 1000, 2000]) {
        await new Promise((r) => setTimeout(r, delay));
        if (!inCall) { wsReconnecting = false; return; }  // user hung up meanwhile
        try {
          ws = await openWs();
          ws.send(buildStartFrame());
          wsReconnecting = false;
          return; // server takes it from here (connecting → live events follow)
        } catch { /* next backoff step */ }
      }
      wsReconnecting = false;
      systemLine('Connection lost — could not reconnect.', 'error');
      endCall('reconnect-failed');
    }

    function onWsMessage(ev) {
      if (typeof ev.data !== 'string') {
        if (playbackNode) playbackNode.port.postMessage(ev.data, [ev.data]);
        return;
      }
      let msg;
      try { msg = JSON.parse(ev.data); } catch { return; }
      switch (msg.type) {
        case 'status':
          setStatus(msg.state, msg.message);
          if (msg.state === 'error' && msg.message) systemLine(msg.message, 'error');
          break;
        case 'transcript':
          appendTranscript(msg.role, msg.text);
          break;
        case 'turnComplete':
          finalizeTurn();
          // Play out any tail audio smaller than the jitter cushion.
          if (playbackNode) playbackNode.port.postMessage('flush');
          break;
        case 'interrupted':
          softInterrupt();
          break;
        case 'tool':
          toolChip(msg.name, msg.phase, msg.error);
          break;
        case 'conversation':
          // The server tells us which conversation this call records (a fresh
          // call learns its new id here) and its (maybe just-derived) title.
          activeConversationId = msg.id;
          updateActiveConvHighlight();
          scheduleConvRefresh();
          break;
        case 'speaker':
          // Silence/unsilence from the app's MCP server (set_speaker_muted).
          setSpeakerMuted(!!msg.muted);
          break;
        case 'mcp':
          // Where every server stands on the server side right now — and the
          // authoritative temporary list (another app may have just added one).
          mcpLive.clear();
          for (const srv of msg.servers ?? []) mcpLive.set(srv.url, srv);
          tempServers = (msg.servers ?? []).filter((s) => s.temporary)
            .map((s) => ({ url: s.url, transport: s.transport ?? 'http', name: s.name ?? '', behavior: s.behavior === 'blocking' ? 'blocking' : 'non-blocking', addedAt: s.addedAt ?? null, toolCount: s.toolCount ?? null }));
          renderMcpBar();
          break;
        default:
          break;
      }
    }

    // ── Browser VAD (Silero v5 via onnxruntime-web) ─────────────────────────
    // Loaded lazily, only for calls with vadMode==='browser'. The model + wasm
    // ship in public/vad/ (relative fetches resolve under the proxy base href).
    // Inference contract mirrors @ricky0123/vad-web's SileroV5 driver:
    // input [1,512] f32 @16 kHz, recurrent state [2,1,128], sr int64; outputs
    // `output` (speech prob) + `stateN`.
    const VAD_WINDOW = 512;                 // 32 ms @ 16 kHz
    const VAD_START_PROB = 0.5;
    const VAD_END_PROB = 0.35;
    const VAD_START_WINDOWS = 2;            // consecutive windows to commit speech-start
    // Echo-guard thresholds while Gemini's audio is audible: speaker bleed must
    // not pass, a real interjection must. (~6 windows ≈ 200 ms of strong speech.)
    const VAD_BARGE_PROB = 0.75;
    const VAD_BARGE_WINDOWS = 6;
    const VAD_PREROLL_FRAMES = 15;          // ~300 ms of 20 ms frames sent on speech-start
    let vadEngine = null;                   // cached across calls (silero or energy)
    let vadEngineKind = null;               // 'silero' | 'energy' | null (null = server VAD)
    let vadSpeaking = false;
    let vadStartRun = 0;
    let vadSilenceMs = 0;
    let vadAccum = new Float32Array(0);     // pending samples until a 512 window fills
    let vadBusy = false;
    const preRoll = [];                     // recent ArrayBuffers while silent/gated
    let modelSpeaking = false;              // playback worklet says audio is audible
    let serverBarge = false;                // server-VAD mode: user broke through the gate
    let serverBargeRun = 0;
    let energyGuard = null;                 // energy detector for server-mode echo guard
    let micNp = -1;                         // RNNoise speech prob of recent mic frames (-1 = no denoiser)
    let rnnoiseBadgeShown = false;

    // wasm SIMD feature probe (ort 1.29 ships ONLY the SIMD build and hard-throws
    // without it — the known Android-WebView failure). Standard detect bytes.
    const SIMD_TEST = new Uint8Array([0, 97, 115, 109, 1, 0, 0, 0, 1, 5, 1, 96, 0, 1, 123,
      3, 2, 1, 0, 10, 10, 1, 8, 0, 65, 0, 253, 15, 253, 98, 11]);

    /** RMS vs. adaptive-noise-floor detector — the no-wasm fallback tier. Less
     * accurate than Silero in noise, but runs on ANY WebView and is plenty to
     * drive activity signals + the echo guard. Maps to pseudo-probs matching
     * the shared thresholds above. */
    function createEnergyVad() {
      let floor = 0.01;
      return {
        kind: 'energy',
        resetState() { floor = 0.01; },
        async prob(window512) {
          // When the RNNoise denoiser is running, its trained per-frame speech
          // probability beats any RMS heuristic — use it directly. (This is
          // the fix for noise slipping past the old threshold.)
          if (micNp >= 0) {
            if (micNp >= 0.6) return 0.9;
            if (micNp >= 0.3) return 0.6;
            return 0.1;
          }
          let sum = 0;
          for (let i = 0; i < window512.length; i++) sum += window512[i] * window512[i];
          const rms = Math.sqrt(sum / window512.length);
          // Fast decay toward quieter, very slow rise — tracks room noise.
          floor = rms < floor ? floor * 0.7 + rms * 0.3 : floor * 0.999 + rms * 0.001;
          if (floor < 1e-4) floor = 1e-4;
          if (rms > floor * 5) return 0.9;
          if (rms > floor * 3) return 0.6;
          return 0.1;
        },
      };
    }

    /** The shell proxy serves everything with `cache-control: no-store`, so
     * the browser would re-download the ~16 MB VAD assets on EVERY page load.
     * CacheStorage ignores response cache headers → one download per device.
     * Plain fetch on insecure contexts (no `caches`) or storage errors. */
    async function cachedFetch(url) {
      try {
        const cache = await caches.open('callgemini-vad-v1');
        const hit = await cache.match(url);
        if (hit) return hit;
        const res = await fetch(url);
        if (res.ok) { try { await cache.put(url, res.clone()); } catch { /* quota — serve uncached */ } }
        return res;
      } catch {
        return fetch(url);
      }
    }

    let energyEngine = null;   // cached dependency-free fallback tier
    let sileroReady = null;    // the Silero engine once (and only once) it's up
    let sileroWarm = null;     // in-flight warm-up (singleton, never rejects)

    /** The actual Silero bring-up. Each stage is labelled so a device failure
     * (e.g. Android WebView without wasm SIMD) reports exactly WHY. Throws —
     * callers go through warmSilero(), which converts failure to null. */
    async function loadSilero() {
      let stage = 'wasm SIMD check';
      try {
        if (typeof WebAssembly === 'undefined' || !WebAssembly.validate(SIMD_TEST)) {
          throw new Error('this WebView has no WebAssembly SIMD support');
        }
        stage = 'load onnxruntime';
        // Self-hosted ort module (copied from onnxruntime-web/dist into
        // public/vad/ort/): the Vite dep-optimized import breaks whenever the
        // dev server restarts while a page is already open (the ?v= hash
        // rotates → "Failed to fetch dynamically imported module" on the
        // tablet). A static asset URL is stable across restarts. Fall back to
        // the bare import if the asset is missing.
        let ort;
        try {
          ort = await import(/* @vite-ignore */ new URL('vad/ort/ort.wasm.bundle.min.mjs', document.baseURI).href);
        } catch (e) {
          console.warn('[callgemini] self-hosted ort import failed, trying dep-optimized:', e?.message ?? e);
          ort = await import('onnxruntime-web');
        }
        ort.env.wasm.numThreads = 1; // no SharedArrayBuffer without cross-origin isolation
        // Explicit absolute mjs URL + prefetched wasm binary: sidesteps the two
        // other WebView failure modes (loader path resolution relative to the
        // ort module, and wasm MIME/streaming-compile strictness).
        ort.env.wasm.wasmPaths = { mjs: new URL('vad/ort/ort-wasm-simd-threaded.mjs', document.baseURI).href };
        stage = 'fetch wasm runtime';
        const wasmRes = await cachedFetch('vad/ort/ort-wasm-simd-threaded.wasm');
        if (!wasmRes.ok) throw new Error(`HTTP ${wasmRes.status}`);
        ort.env.wasm.wasmBinary = await wasmRes.arrayBuffer();
        stage = 'fetch silero model';
        const modelRes = await cachedFetch('vad/silero_vad_v5.onnx');
        if (!modelRes.ok) throw new Error(`HTTP ${modelRes.status}`);
        const model = await modelRes.arrayBuffer();
        stage = 'create session';
        // Prefer inference in ort's proxy worker: VAD windows run every 32 ms
        // DURING playback, and on weak devices main-thread wasm competes with
        // feeding the playback worklet (audible as cuts). Proxy failure (some
        // WebViews) falls back to the main-thread session — correct, just
        // heavier.
        let session;
        try {
          ort.env.wasm.proxy = true;
          session = await ort.InferenceSession.create(model);
        } catch (proxyErr) {
          console.warn('[callgemini] ort proxy worker unavailable, running VAD on main thread:', proxyErr?.message ?? proxyErr);
          ort.env.wasm.proxy = false;
          session = await ort.InferenceSession.create(model);
        }
        // IMPORTANT: in proxy mode session.run() TRANSFERS each tensor's
        // ArrayBuffer to the worker, detaching it — a reused tensor throws
        // DataCloneError on the second call and kills the VAD (and with it
        // the whole call). Build every tensor fresh per inference; only the
        // recurrent state DATA survives between calls, copied out each run.
        let stateData = new Float32Array(2 * 128);
        return {
          kind: 'silero',
          resetState() { stateData = new Float32Array(2 * 128); },
          async prob(window512) {
            const input = new ort.Tensor('float32', window512, [1, VAD_WINDOW]);
            const state = new ort.Tensor('float32', stateData, [2, 1, 128]);
            const sr = new ort.Tensor('int64', [16000n]);
            const out = await session.run({ input, state, sr });
            stateData = new Float32Array(out.stateN.data);
            return out.output.data[0];
          },
        };
      } catch (err) {
        console.error(`[callgemini] Silero VAD init failed at "${stage}":`, err);
        systemLine(`Silero VAD unavailable (${stage}: ${err?.message ?? err}) — using energy-based detection.`, 'info');
        throw err;
      }
    }

    /** Kick off (or join) the Silero warm-up. Resolves to the engine, or null
     * if this device can't run it — never rejects, and never blocks a call:
     * startCall dials with the energy tier and hot-swaps when this lands. */
    function warmSilero() {
      if (!sileroWarm) {
        sileroWarm = loadSilero()
          .then((engine) => { sileroReady = engine; return engine; })
          .catch(() => null);
      }
      return sileroWarm;
    }

    function resetVadCallState() {
      vadSpeaking = false; vadStartRun = 0; vadSilenceMs = 0;
      vadAccum = new Float32Array(0); preRoll.length = 0;
      serverBarge = false; serverBargeRun = 0; modelSpeaking = false;
      micNp = -1; rnnoiseBadgeShown = false;
      vadEngine?.resetState();
      energyGuard?.resetState();
    }

    function sendFrame(buf) {
      if (ws && ws.readyState === WebSocket.OPEN) ws.send(buf);
    }

    function bufferPreRoll(buf) {
      preRoll.push(buf.slice(0));
      if (preRoll.length > VAD_PREROLL_FRAMES) preRoll.shift();
    }

    function flushPreRoll() {
      for (const b of preRoll) sendFrame(b);   // don't clip the utterance onset
      preRoll.length = 0;
    }

    function onVadProb(prob, windowMs) {
      if (!vadSpeaking) {
        // Echo guard: while Gemini's audio is audible the bar is higher, so
        // speaker bleed into the mic can't trigger us — a real interjection
        // (louder, sustained) still does.
        const startProb = modelSpeaking ? VAD_BARGE_PROB : VAD_START_PROB;
        const startWindows = modelSpeaking ? VAD_BARGE_WINDOWS : VAD_START_WINDOWS;
        // Denoiser cross-check on speech-START only: if RNNoise says the recent
        // audio is clean silence, a click/hum can't accumulate a start run.
        // End-of-speech logic is untouched so the user is never clipped.
        const npVeto = micNp >= 0 && micNp < 0.05;
        vadStartRun = (prob >= startProb && !npVeto) ? vadStartRun + 1 : 0;
        if (vadStartRun >= startWindows) {
          vadSpeaking = true; vadSilenceMs = 0;
          // Instant local barge-in: fade Gemini out the moment the user speaks
          // instead of waiting for the server's `interrupted` round-trip. The
          // activityStart below is the server-side interrupt (the Live API
          // default is START_OF_ACTIVITY_INTERRUPTS).
          softInterrupt();
          ws?.send(JSON.stringify({ type: 'vad', event: 'start' }));
          flushPreRoll();
        }
      } else if (prob < VAD_END_PROB) {
        vadSilenceMs += windowMs;
        const hangover = RESPONSIVENESS_MS[config.responsiveness] ?? RESPONSIVENESS_MS.balanced;
        if (vadSilenceMs >= hangover) {
          vadSpeaking = false; vadStartRun = 0; vadSilenceMs = 0;
          ws?.send(JSON.stringify({ type: 'vad', event: 'end' }));
        }
      } else {
        vadSilenceMs = 0;
      }
    }

    /** Server-VAD mode echo guard: while Gemini audio is audible the mic is
     * gated (Gemini must not hear itself), and this local energy detector
     * decides when the user genuinely talks over it — then we flush the
     * pre-roll and resume streaming so Gemini's own VAD sees the barge-in. */
    function onServerGuardProb(prob) {
      serverBargeRun = prob >= VAD_BARGE_PROB ? serverBargeRun + 1 : 0;
      if (serverBargeRun >= VAD_BARGE_WINDOWS) {
        serverBarge = true;
        flushPreRoll();
      }
    }

    /** Chunk mic audio into 512-sample windows for whichever detector is on. */
    function feedDetector(buf, engine, onProb) {
      const i16 = new Int16Array(buf);
      const merged = new Float32Array(vadAccum.length + i16.length);
      merged.set(vadAccum, 0);
      for (let k = 0; k < i16.length; k++) merged[vadAccum.length + k] = i16[k] / 0x8000;
      vadAccum = merged;
      if (vadAccum.length >= VAD_WINDOW && !vadBusy) {
        const window512 = vadAccum.slice(0, VAD_WINDOW);
        vadAccum = vadAccum.slice(VAD_WINDOW);
        vadBusy = true;
        engine.prob(window512)
          .then((p) => { vadFailStreak = 0; onProb(p, (VAD_WINDOW / 16000) * 1000); })
          .catch((err) => {
            console.error('[callgemini] vad inference failed:', err);
            // A persistently failing detector DEAFENS the call (no speech
            // starts → nothing streams to Gemini). After a short failure
            // streak on the Silero tier, swap to the energy tier live.
            if (engine === vadEngine && vadEngineKind === 'silero' && ++vadFailStreak >= 5) {
              vadFailStreak = 0;
              vadEngine = (energyEngine ??= createEnergyVad());
              vadEngine.resetState();
              vadEngineKind = 'energy';
              setVadBadge('energy');
              systemLine('Silero VAD failed mid-call — switched to energy detection.', 'error');
            }
          })
          .finally(() => { vadBusy = false; });
      }
    }

    function onMicFrame(buf, np = -1) {
      if (muted) { userLevel = 0; return; }
      micNp = np;
      // Badge honesty: if the fallback energy tier is being driven by RNNoise
      // probs, say so (once, when the first denoised frame proves it's live).
      if (np >= 0 && vadEngineKind === 'energy' && !rnnoiseBadgeShown) {
        rnnoiseBadgeShown = true;
        setVadBadge('rnnoise');
      }

      // Cheap strided RMS for the button glow (every 4th sample of 20 ms).
      {
        const i16 = new Int16Array(buf);
        let sum = 0, n = 0;
        for (let k = 0; k < i16.length; k += 4) { const s = i16[k] / 0x8000; sum += s * s; n++; }
        userLevel = Math.sqrt(sum / (n || 1));
      }

      // Capture is verified before dialing. Do not advance VAD state until
      // there is a socket to receive its activity signals.
      if (!ws || ws.readyState !== WebSocket.OPEN) return;

      if (vadEngineKind === null) {
        // Server-VAD mode. Normally stream continuously — but while Gemini's
        // audio is audible, gate the mic so it can't hear itself. The energy
        // detector opens the gate when the user genuinely barges in.
        if (modelSpeaking && !serverBarge) {
          bufferPreRoll(buf);
          if (!energyGuard) energyGuard = createEnergyVad();
          feedDetector(buf, energyGuard, onServerGuardProb);
          return;
        }
        sendFrame(buf);
        return;
      }

      // Browser-VAD mode (silero or energy): buffer while silent, stream while
      // speaking, and let the detector drive the activity signals.
      if (vadSpeaking) sendFrame(buf);
      else bufferPreRoll(buf);
      feedDetector(buf, vadEngine, onVadProb);
    }

    async function startCapture(audio) {
      const stream = await audio.microphone();
      audio.assertActive();
      captureStream = stream;
      const context = audio.context;

      // Noise reduction 'ai' loads the RNNoise variant of the capture worklet
      // (a separate module so calls without it never download the ~2 MB wasm).
      // Any load failure falls back to the plain worklet — never break capture.
      let processorName = 'capture-worklet';
      if ((config.noiseReduction ?? DEFAULTS.noiseReduction) === 'ai' && context.sampleRate === 48000) {
        try {
          await context.audioWorklet.addModule('worklets/capture-denoise-worklet.js');
          audio.assertActive();
          processorName = 'capture-worklet-denoise';
        } catch (err) {
          audio.assertActive();
          console.error('[callgemini] denoise worklet failed to load, using plain capture:', err);
          systemLine('AI noise reduction unavailable — using browser filters only.', 'info');
        }
      }
      if (processorName === 'capture-worklet') {
        if ((config.noiseReduction ?? DEFAULTS.noiseReduction) === 'ai' && context.sampleRate !== 48000) {
          systemLine('Using browser noise reduction for this audio device.', 'info');
        }
        await context.audioWorklet.addModule('worklets/capture-worklet.js');
        audio.assertActive();
      }

      const source = captureCtx.createMediaStreamSource(captureStream);
      // Classical gain staging BEFORE any AI: a 100 Hz highpass kills rumble /
      // handling noise / wind body (speech intelligibility lives above it),
      // and a compressor catches spikes so nothing clips — RNNoise (and the
      // VADs) want a stable, unclipped signal. Native nodes, zero CPU cost
      // worth mentioning. The denoise worklet adds a second, ADAPTIVE highpass
      // that slides up to 300 Hz when it detects wind buffeting.
      const highpass = captureCtx.createBiquadFilter();
      highpass.type = 'highpass';
      highpass.frequency.value = 100;
      const compressor = captureCtx.createDynamicsCompressor();
      compressor.threshold.value = -24;
      compressor.knee.value = 30;
      compressor.ratio.value = 12;
      compressor.attack.value = 0.003;
      compressor.release.value = 0.25;

      const node = new AudioWorkletNode(captureCtx, processorName);
      let firstFrame;
      const captureStarted = new Promise((resolve) => { firstFrame = resolve; });
      node.addEventListener('processorerror', () => console.error('[callgemini] capture processor failed:', processorName));
      node.port.onmessage = (e) => {
        const d = e.data;
        if (d && d.buf) {
          if (callAudio !== audio) return;
          firstFrame();
          onMicFrame(d.buf, d.np);
          return;
        }
        if (d && d.denoiseError) {
          console.error('[callgemini] RNNoise init failed:', d.denoiseError);
          systemLine(`AI noise reduction failed (${d.denoiseError}) — continuing without it.`, 'info');
        }
      };
      // A worklet is only pulled if it feeds a sink — route through a muted gain
      // so the mic never echoes to the speakers.
      const sink = captureCtx.createGain();
      sink.gain.value = 0;
      source.connect(highpass).connect(compressor).connect(node).connect(sink).connect(captureCtx.destination);
      // Permission and state='running' are not proof of working capture on
      // iOS. Require an actual PCM frame before announcing/dialing the call.
      let frameTimer;
      try {
        await audio.waitFor(Promise.race([captureStarted, new Promise((_, reject) => {
          frameTimer = setTimeout(() => reject(new Error('Microphone access was granted, but the browser produced no audio. Close other calls or recording apps, then tap Call again.')), 5000);
        })]));
      } finally { clearTimeout(frameTimer); }
    }

    /** Android WebView (Capacitor et al.): UA carries "; wv)" on modern builds
     * or the legacy "Version/x.y" token alongside Chrome. */
    function isAndroidWebView() {
      const ua = navigator.userAgent;
      return ua.includes('; wv)') || (/Android/.test(ua) && /Version\/[\d.]+/.test(ua));
    }

    function isAppleMobile() {
      return /iPad|iPhone|iPod/.test(navigator.userAgent)
        || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    }

    /** Route playback to the configured output device. `target` is the
     * playback <audio> element or the AudioContext (Chrome 110+ supports
     * setSinkId on both). Unavailable device / unsupported browser → stay on
     * the default sink, never break the call. */
    async function applyOutputSink(target) {
      const id = config.outputDeviceId ?? DEFAULTS.outputDeviceId;
      if (!id || typeof target?.setSinkId !== 'function') return;
      try {
        await target.setSinkId(id);
      } catch (err) {
        console.error('[callgemini] setSinkId failed:', err);
        systemLine('Selected audio output unavailable — using default.', 'info');
      }
    }

    /** Config volume, clamped to the slider's 0–300% range. */
    function volumePct() {
      const pct = Number(config.volume ?? DEFAULTS.volume);
      return Math.max(0, Math.min(300, Number.isFinite(pct) ? pct : 100));
    }

    /** Slider % → linear gain. 0–200% is what it says; 200–300% secretly
     * ramps to DOUBLE the nominal boost (300% → ×6) for extra overdrive
     * headroom — continuous at 200% so there's no jump mid-drag. The
     * limiter behind the gain soaks the peaks. */
    function volumeLevel() {
      if (speakerMuted) return 0;
      const pct = volumePct();
      return pct <= 200 ? pct / 100 : 2 + ((pct - 200) / 100) * 4;
    }

    /** Reflect config.volume in the slider UI (label + overdrive tint). */
    function renderVolume() {
      const pct = Math.round(volumePct());
      if (els.volSlider) els.volSlider.value = String(pct);
      if (els.volVal) els.volVal.textContent = speakerMuted ? 'Muted' : `${pct}%`;
      if (els.speakerBtn) {
        const label = speakerMuted ? 'Unsilence speaker' : 'Silence speaker';
        els.speakerBtn.title = label;
        els.speakerBtn.setAttribute('aria-label', label);
        els.speakerBtn.setAttribute('aria-pressed', String(speakerMuted));
      }
      if (els.volIconSlot) { els.volIconSlot.textContent = ''; els.volIconSlot.appendChild(icon(speakerMuted ? VolumeX : Volume2, 18)); }
      if (els.volCtl) {
        els.volCtl.dataset.muted = String(speakerMuted);
        els.volCtl.dataset.overdrive = String(pct > 100);
        els.volCtl.title = speakerMuted ? 'Speaker silenced — click the speaker to restore'
          : pct > 200
          ? `Playback volume — deep overdrive (×${volumeLevel().toFixed(1)} actual gain)`
          : 'Playback volume — past 100% is overdrive';
      }
    }

    /** Apply the configured volume to a live call (no-op between calls —
     * startPlayback seeds the node from config). Short ramp, no zipper. */
    function applyVolume() {
      if (volumeGain && playbackCtx) {
        volumeGain.gain.setTargetAtTime(volumeLevel(), playbackCtx.currentTime, 0.03);
      }
    }

    /** Silence / unsilence Gemini's voice (output only — mic and call go on).
     * Always reports the resulting state to the server, which is also the
     * confirmation a remote set_speaker_muted waits for. */
    function setSpeakerMuted(next) {
      speakerMuted = !!next;
      renderVolume();
      applyVolume();
      try { ws?.readyState === WebSocket.OPEN && ws.send(JSON.stringify({ type: 'speaker', muted: speakerMuted })); } catch { /* noop */ }
    }
    function toggleSpeaker() { setSpeakerMuted(!speakerMuted); }

    async function startPlayback(audio) {
      await audio.context.audioWorklet.addModule('worklets/playback-worklet.js?v=shared-native-v1');
      audio.assertActive();
      playbackNode = new AudioWorkletNode(playbackCtx, 'playback-worklet');
      // The worklet reports exactly when model audio is audible — this drives
      // the software echo guard (stricter barge-in / server-mode mic gating)
      // and, via the level reports, the call button's audio-reactive glow.
      playbackNode.port.onmessage = (e) => {
        if (e.data === 'playing') { modelSpeaking = true; return; }
        if (e.data === 'idle') {
          modelSpeaking = false;
          serverBarge = false; serverBargeRun = 0;
          // Gate-buffered frames are stale once Gemini stops talking.
          if (!vadSpeaking) preRoll.length = 0;
          return;
        }
        if (e.data && e.data.t === 'level') { modelLevel = e.data.v; return; }
        if (e.data && e.data.t === 'underrun') {
          // The jitter cushion just grew after a mid-sentence dry-out. Log
          // each; tell the user once per call so field reports are possible
          // without devtools.
          console.log(`[callgemini] playback underrun — jitter cushion now ${e.data.cushionMs} ms`);
          if (!underrunNoted) {
            underrunNoted = true;
            systemLine(`Network jitter detected — audio buffering increased to ${e.data.cushionMs} ms for this call.`, 'info');
          }
        }
      };
      // Fade stage so interruptions can ramp down instead of clicking off.
      playbackGain = playbackCtx.createGain();
      playbackNode.connect(playbackGain);
      // User volume — SEPARATE node from the fade stage so softInterrupt's
      // 0→1 restore never stomps the user's setting. Above 100% (overdrive)
      // the limiter behind it catches the peaks so boosted audio saturates
      // softly instead of hard-clipping at the DAC.
      volumeGain = playbackCtx.createGain();
      volumeGain.gain.value = volumeLevel();
      const limiter = playbackCtx.createDynamicsCompressor();
      limiter.threshold.value = -6;
      limiter.knee.value = 6;
      limiter.ratio.value = 20;
      limiter.attack.value = 0.002;
      limiter.release.value = 0.15;
      playbackGain.connect(volumeGain).connect(limiter);
      if (isAndroidWebView()) {
        // WebView: the echoCancellation constraint usually isn't backed by a
        // real canceller, and media-element output plays on the (louder) media
        // audio path — the element route is pure downside there. Use the
        // direct route; the software echo guard handles the bleed.
        limiter.connect(playbackCtx.destination);
        await applyOutputSink(playbackCtx);
        return;
      }
      // Desktop: route through a MediaStream → hidden <audio> element instead
      // of ctx.destination ON PURPOSE — the browser's echo canceller only
      // subtracts playback it can "see" (WebRTC / media elements), not raw
      // AudioContext output. Without this, speakers-without-headphones feed
      // Gemini's voice back into the mic and the VAD triggers on it. Costs a
      // few ms of element buffering — worth it.
      const dest = playbackCtx.createMediaStreamDestination();
      limiter.connect(dest);
      playbackEl = new Audio();
      playbackEl.setAttribute('playsinline', '');
      playbackEl.srcObject = dest.stream;
      await applyOutputSink(playbackEl);
      try {
        await playbackEl.play();
      } catch (err) {
        // Autoplay-policy edge case: never let audio silently break just to
        // gain AEC — fall back to the direct (non-AEC) route.
        console.error('[callgemini] media-element playback blocked, falling back:', err);
        playbackEl.srcObject = null;
        playbackEl = null;
        limiter.disconnect(dest);
        limiter.connect(playbackCtx.destination);
        await applyOutputSink(playbackCtx);
      }
    }

    /**
     * Soft barge-in: ramp Gemini's volume to zero over ~80 ms, THEN clear the
     * buffer — a hard postMessage('clear') alone truncates mid-sample and
     * sounds like a digital click. Gain is restored for the next reply.
     */
    function softInterrupt() {
      if (!playbackNode) return;
      if (!playbackGain || fading) { playbackNode.port.postMessage('clear'); return; }
      fading = true;
      const g = playbackGain.gain;
      const now = playbackCtx.currentTime;
      g.cancelScheduledValues(now);
      g.setValueAtTime(g.value, now);
      g.linearRampToValueAtTime(0.0001, now + 0.08);
      setTimeout(() => {
        playbackNode?.port.postMessage('clear');
        const t = playbackCtx?.currentTime ?? 0;
        g.cancelScheduledValues(t);
        g.setValueAtTime(1, t);
        fading = false;
      }, 90);
    }

    // ── Audio-reactive call button (the minimal "audio mirror") ─────────────
    // Real levels only: mic RMS (set in onMicFrame) vs. the playback worklet's
    // rendered RMS. Fast attack / slow decay, capped small — decent, no layout
    // shift (transform + shadow only).
    function levelTick() {
      const target = Math.min(1, Math.max(userLevel, modelLevel) * 4);
      smoothedLevel = target > smoothedLevel
        ? smoothedLevel * 0.5 + target * 0.5
        : smoothedLevel * 0.88;
      if (smoothedLevel < 0.01) smoothedLevel = 0;
      if (els.callBtn) {
        els.callBtn.style.setProperty('--cg-level', smoothedLevel.toFixed(3));
        els.callBtn.dataset.voice = modelSpeaking ? 'model' : (userLevel * 4 > 0.12 ? 'user' : '');
      }
      levelRaf = requestAnimationFrame(levelTick);
    }

    function startLevelLoop() {
      if (!levelRaf) levelRaf = requestAnimationFrame(levelTick);
    }

    function stopLevelLoop() {
      if (levelRaf) cancelAnimationFrame(levelRaf);
      levelRaf = 0; userLevel = 0; modelLevel = 0; smoothedLevel = 0;
      if (els.callBtn) {
        els.callBtn.style.setProperty('--cg-level', '0');
        els.callBtn.dataset.voice = '';
      }
    }

    function stopAudio() {
      callAudio?.close();
      callAudio = null;
      try { playbackEl?.pause(); if (playbackEl) playbackEl.srcObject = null; } catch { /* noop */ }
      captureStream = null; captureCtx = null; playbackCtx = null; playbackNode = null; playbackGain = null; volumeGain = null; playbackEl = null;
      fading = false;
    }

    async function startCall() {
      if (inCall) return;
      // Plain-HTTP LAN origins (http://<ip>:3000) are insecure contexts: the
      // browser removes audioWorklet, getUserMedia and CacheStorage there, so
      // a call CANNOT work. Fail with the reason, not a cryptic TypeError.
      if (!window.isSecureContext) {
        systemLine(`Calls need a secure origin — this page is ${location.origin}, where the browser blocks microphone capture and audio processing. Open AuraOS via localhost, HTTPS, or the app wrapper (or allowlist this origin under chrome://flags/#unsafely-treat-insecure-origin-as-secure).`, 'error');
        setStatus('error');
        return;
      }
      inCall = true;
      muted = false;
      underrunNoted = false;
      updateControls();
      setStatus('connecting');
      let audio;
      try {
        // Must run in the original tap, before the first await. Both graphs
        // share one context; playback resamples Gemini's 24 kHz when needed.
        // This iPad reports a running 48 kHz context whose clock never moves;
        // its 24 kHz playback context does run. Use that rate for BOTH graphs
        // on iOS, and native hardware rate elsewhere. Capture still emits 16 kHz.
        audio = createCallAudio({ micDeviceId: config.micDeviceId ?? '',
          ...(isAppleMobile() ? { sampleRate: 24000 } : {}) });
        callAudio = audio;
        captureCtx = playbackCtx = audio.context;
        // VAD *mode* is fixed at connect time, but silero-vs-energy is purely
        // client-side — the server only ever sees "browser VAD". So never
        // block the dial on the ~16 MB Silero download: start with whichever
        // tier is ready NOW and hot-swap to Silero the moment its warm-up
        // (kicked off at page load) resolves. No re-dial needed.
        vadEngineKind = null;
        if ((config.vadMode ?? DEFAULTS.vadMode) === 'browser') {
          const warm = warmSilero();
          if (sileroReady) {
            vadEngine = sileroReady;
            vadEngineKind = 'silero';
            systemLine('Browser VAD: Silero', 'info');
          } else {
            vadEngine = (energyEngine ??= createEnergyVad());
            vadEngineKind = 'energy';
            systemLine('Browser VAD: energy (Silero still warming up)', 'info');
            warm.then((engine) => {
              // Swap only if this call is still live and still on the fallback.
              if (!engine || !inCall || vadEngineKind !== 'energy') return;
              engine.resetState();
              vadEngine = engine;
              vadEngineKind = 'silero';
              setVadBadge('silero');
              systemLine('Silero VAD ready — switched over.', 'info');
            });
          }
        }
        resetVadCallState();
        setVadBadge(vadEngineKind ?? 'server');   // what's REALLY driving this call
        await audio.microphone();
        await audio.resume();
        await startPlayback(audio);
        audio.assertActive();
        await startCapture(audio);
        audio.assertActive();
        const socket = await openWs();
        if (callAudio !== audio) { socket.close(); return; }
        ws = socket;
        // conversationId set → resume that conversation with its history as context.
        ws.send(buildStartFrame());
        startLevelLoop();
        systemLine(`Call started · ${describeSetup()}`, 'info');
      } catch (err) {
        if (audio && callAudio !== audio) return; // call was cancelled/replaced
        console.error('[callgemini] startCall failed:', err);
        systemLine(`Could not start call: ${err?.message ?? err}`, 'error');
        endCall('start-failed');
        setStatus('error');
      }
    }

    // Foregrounding and a fresh tap are opportunities to resume audio after
    // an iOS interruption. These handlers never request a new microphone.
    function resumeCallAudio() {
      const audio = callAudio;
      if (!inCall || !audio || audio.context.state === 'running') return;
      void audio.resume().catch((err) => {
        if (callAudio === audio) console.warn('[callgemini] audio resume failed:', err.message);
      });
    }
    document.addEventListener('pointerdown', resumeCallAudio, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') resumeCallAudio();
    });

    function endCall(_reason) {
      if (!inCall) return;
      inCall = false;
      try { ws?.readyState === WebSocket.OPEN && ws.send(JSON.stringify({ type: 'stop' })); } catch { /* noop */ }
      try { ws?.close(); } catch { /* noop */ }
      ws = null;
      stopAudio();
      stopLevelLoop();
      vadEngineKind = null;
      setVadBadge(null);
      resetVadCallState();
      finalizeTurn();
      toolChips.clear();
      mcpLive.clear();
      renderMcpBar();
      setStatus('ended');
      updateControls();
    }

    function toggleCall() {
      if (inCall) endCall('user'); else startCall();
    }

    function toggleMute() {
      if (!inCall) return;
      muted = !muted;
      updateControls();
    }

    function updateControls() {
      if (els.callBtn) {
        els.callBtn.dataset.active = String(inCall);
        els.callBtn.textContent = inCall ? 'End call' : 'Call';
      }
      if (els.muteBtn) {
        els.muteBtn.disabled = !inCall;
        els.muteBtn.dataset.muted = String(muted);
        els.muteBtn.setAttribute('aria-pressed', String(muted));
        els.muteBtn.title = muted ? 'Unmute microphone' : 'Mute microphone';
        els.muteBtn.setAttribute('aria-label', els.muteBtn.title);
        // Mic (live) ↔ MicOff (muted): swap the SVG so the state is readable at a glance.
        if (els.muteIcon) { els.muteIcon.textContent = ''; els.muteIcon.appendChild(icon(muted ? MicOff : Mic, 18)); }
        if (els.muteLabel) els.muteLabel.textContent = muted ? 'Unmute' : 'Mute';
      }
    }

    /** Rows are a draft: only Save copies them into `config`. */
    function renderMcpRows(list = config.mcpServers ?? []) {
      els.mcpList.textContent = '';
      list.forEach((srv) => {
        const row = document.createElement('div');
        row.className = 'mcp-row';

        const url = document.createElement('input');
        url.className = 'field-input mcp-url';
        url.type = 'url';
        url.placeholder = 'https://server/mcp';
        url.value = srv.url ?? '';
        url.dataset.k = 'url';

        const transport = document.createElement('select');
        transport.className = 'field-input mcp-transport';
        transport.dataset.k = 'transport';
        for (const t of ['http', 'sse']) {
          const opt = document.createElement('option');
          opt.value = t; opt.textContent = t.toUpperCase();
          if ((srv.transport ?? 'http') === t) opt.selected = true;
          transport.appendChild(opt);
        }

        // Per-server tool-call behavior: async (default) answers slow calls
        // with "working on it" and announces the result later; blocking makes
        // Gemini wait for the full result (see src/server/mcp.mjs).
        const behavior = document.createElement('select');
        behavior.className = 'field-input mcp-behavior';
        behavior.dataset.k = 'behavior';
        behavior.title = 'Async: slow tools answer "working on it", the result is announced later. Blocking: Gemini waits for the full result.';
        for (const [v, label] of [['non-blocking', 'Async'], ['blocking', 'Blocking']]) {
          const opt = document.createElement('option');
          opt.value = v; opt.textContent = label;
          if ((srv.behavior === 'blocking' ? 'blocking' : 'non-blocking') === v) opt.selected = true;
          behavior.appendChild(opt);
        }

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'btn-del';
        del.dataset.action = 'mcp-del';
        del.textContent = 'Remove';

        row.append(url, transport, behavior, del);
        els.mcpList.appendChild(row);
      });
    }

    function readMcpRows() {
      const rows = [...els.mcpList.querySelectorAll('.mcp-row')];
      return rows.map((row) => ({
        url: row.querySelector('.mcp-url').value.trim(),
        transport: row.querySelector('.mcp-transport').value,
        behavior: row.querySelector('.mcp-behavior')?.value === 'blocking' ? 'blocking' : 'non-blocking',
      })).filter((s) => s.url);
    }

    function fillSelect(sel, opts, selected) {
      sel.textContent = '';
      for (const o of opts) {
        const opt = document.createElement('option');
        opt.value = o.value; opt.textContent = o.label;
        if (selected === o.value) opt.selected = true;
        sel.appendChild(opt);
      }
    }

    /**
     * Fill the mic / output selects from enumerateDevices. Labels are blank
     * until mic permission is granted, so on a label-less list we try a
     * one-shot getUserMedia (stopped immediately) to unlock them; if the user
     * declines we still list the devices with generic names. Never throws —
     * a failure just leaves "System default" as the only choice.
     */
    async function populateDeviceSelects() {
      try {
        if (!navigator.mediaDevices?.enumerateDevices) return;
        let devices = await navigator.mediaDevices.enumerateDevices();
        const unlabeled = devices.some((d) => (d.kind === 'audioinput' || d.kind === 'audiooutput') && d.deviceId && !d.label);
        if (unlabeled) {
          try {
            const s = await navigator.mediaDevices.getUserMedia({ audio: true });
            s.getTracks().forEach((t) => t.stop());
            devices = await navigator.mediaDevices.enumerateDevices();
          } catch { /* permission declined — keep generic labels */ }
        }
        const toOpts = (kind, generic) => {
          const opts = [{ value: '', label: 'System default' }];
          let n = 0;
          for (const d of devices) {
            if (d.kind !== kind || !d.deviceId || d.deviceId === 'default') continue;
            n += 1;
            opts.push({ value: d.deviceId, label: d.label || `${generic} ${n}` });
          }
          return opts;
        };
        const fill = (sel, kind, generic, saved) => {
          const opts = toOpts(kind, generic);
          if (saved && !opts.some((o) => o.value === saved)) {
            opts.push({ value: saved, label: `Saved device (unavailable)` });
          }
          fillSelect(sel, opts, saved ?? '');
        };
        // On a devicechange refresh the select already holds the user's (maybe
        // unsaved) choice — keep that; on first fill fall back to the config.
        const current = (sel, cfg) => (sel.options.length > 1 ? sel.value : (cfg ?? ''));
        const saved = draft?.global ?? config;
        fill(els.fMicDevice, 'audioinput', 'Microphone', current(els.fMicDevice, saved.micDeviceId));
        fill(els.fOutputDevice, 'audiooutput', 'Speaker', current(els.fOutputDevice, saved.outputDeviceId));
      } catch (err) {
        console.error('[callgemini] device enumeration failed:', err);
      }
    }

    function syncModelCustomVisibility() {
      els.modelField.dataset.custom = String(els.fModelPreset.value === 'custom');
    }

    // ── Languages multi-select (toggle chips; empty = Any/auto-detect) ──────
    function renderLangChips(selected) {
      const on = new Set(selected ?? []);
      els.langChips.textContent = '';
      const any = document.createElement('button');
      any.type = 'button'; any.className = 'lang-chip'; any.dataset.lang = '';
      any.textContent = 'Any'; any.dataset.on = String(on.size === 0);
      els.langChips.appendChild(any);
      for (const l of LANGUAGES) {
        const chip = document.createElement('button');
        chip.type = 'button'; chip.className = 'lang-chip'; chip.dataset.lang = l.code;
        chip.textContent = l.label; chip.dataset.on = String(on.has(l.code));
        els.langChips.appendChild(chip);
      }
    }

    function syncAnyChip() {
      const anySelected = [...els.langChips.querySelectorAll('.lang-chip[data-lang]')]
        .some((c) => c.dataset.lang && c.dataset.on === 'true');
      const any = els.langChips.querySelector('.lang-chip[data-lang=""]');
      if (any) any.dataset.on = String(!anySelected);
    }

    function readLangChips() {
      return [...els.langChips.querySelectorAll('.lang-chip[data-lang]')]
        .filter((c) => c.dataset.lang && c.dataset.on === 'true')
        .map((c) => c.dataset.lang);
    }

    // ── Settings view: a draft of `store`, committed on Save ────────────────
    // Form fields are the view of the draft's current profile / role /
    // version; pullForm() copies them back before anything re-renders (a
    // profile, role, version or tab switch) and before dirty-check / Save.
    let draft = null;
    const settingsUi = { roleId: null, versionN: null };
    const TAB_KEY = 'cg.settingsTab';
    const TABS = ['roles', 'model', 'integrations', 'global'];

    const draftProfile = () => activeProfile(draft);
    const viewedRole = () => draftProfile().roles.find((r) => r.id === settingsUi.roleId) ?? null;

    /** "Work · Developer v3" — what the next call will use. */
    function describeSetup(s = store) {
      const p = activeProfile(s);
      const r = activeRole(p);
      return r ? `${p.name} · ${r.name} v${r.activeVersion}` : `${p.name} · default prompt`;
    }

    function pullForm() {
      if (!draft) return;
      const g = draft.global;
      g.apiKey = els.fApiKey.value.trim();
      g.languages = readLangChips();
      g.micDeviceId = deviceValue(els.fMicDevice, g.micDeviceId);
      g.outputDeviceId = deviceValue(els.fOutputDevice, g.outputDeviceId);
      g.noiseReduction = els.fNoise.value || DEFAULTS.noiseReduction;
      g.vadMode = els.fVadMode.value || DEFAULTS.vadMode;
      g.responsiveness = els.fResponsiveness.value || DEFAULTS.responsiveness;

      const p = draftProfile();
      const preset = els.fModelPreset.value;
      p.model = (preset === 'custom' ? els.fModel.value.trim() : preset) || DEFAULTS.model;
      p.voiceName = els.fVoice.value || DEFAULTS.voiceName;
      p.acpAddress = els.fAcpAddress.value.trim();
      p.mcpServers = readMcpRows();

      const r = viewedRole();
      if (r && !isFrozen(r, settingsUi.versionN)) versionOf(r, settingsUi.versionN).text = els.fRoleText.value;
    }

    function renderGlobalFields() {
      const g = draft.global;
      els.fApiKey.value = g.apiKey ?? '';
      fillSelect(els.fVadMode, VAD_MODE_OPTS, g.vadMode ?? DEFAULTS.vadMode);
      fillSelect(els.fNoise, NOISE_OPTS, g.noiseReduction ?? DEFAULTS.noiseReduction);
      fillSelect(els.fResponsiveness, RESPONSIVENESS_OPTS, g.responsiveness ?? DEFAULTS.responsiveness);
      renderLangChips(g.languages ?? DEFAULTS.languages);
      // Device lists load async (enumeration + possible permission prompt);
      // until then the selects just show "System default".
      fillSelect(els.fMicDevice, [{ value: '', label: 'System default' }], '');
      fillSelect(els.fOutputDevice, [{ value: '', label: 'System default' }], '');
      void populateDeviceSelects();
    }

    function renderProfileBar() {
      fillSelect(els.profileSelect, draft.profiles.map((p) => ({ value: p.id, label: p.name })), draft.activeProfileId);
      const del = els.settingsView.querySelector('[data-action="profile-delete"]');
      if (del) del.disabled = draft.profiles.length < 2;
    }

    function renderProfileFields() {
      const p = draftProfile();
      // Model: select the matching preset, else Custom… with the raw id shown.
      const modelId = p.model || DEFAULTS.model;
      const preset = MODEL_PRESETS.find((m) => m.value === modelId) ? modelId : 'custom';
      fillSelect(els.fModelPreset, MODEL_PRESETS, preset);
      els.fModel.value = preset === 'custom' ? modelId : '';
      syncModelCustomVisibility();
      fillSelect(els.fVoice, VOICES.map((v) => ({ value: v, label: v })), p.voiceName || DEFAULTS.voiceName);
      els.fAcpAddress.value = p.acpAddress ?? '';
      renderMcpRows(p.mcpServers ?? []);
    }

    function renderRoles() {
      const p = draftProfile();
      if (!viewedRole()) settingsUi.roleId = p.activeRoleId ?? p.roles[0]?.id ?? null;
      const r = viewedRole();
      if (r && !versionOf(r, settingsUi.versionN)) settingsUi.versionN = r.activeVersion;

      const label = (x) => (x.id === p.activeRoleId ? `${x.name} · active` : x.name);
      fillSelect(els.roleSelect, p.roles.map((x) => ({ value: x.id, label: label(x) })), settingsUi.roleId);
      els.roleSelect.disabled = p.roles.length === 0;

      // Wide layout: the same roles as a clickable list (createElement — see the
      // is:global note on the style block).
      els.rolesList.textContent = '';
      for (const x of p.roles) {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'roles-list-item';
        item.dataset.roleId = x.id;
        item.dataset.selected = String(x.id === settingsUi.roleId);
        item.dataset.active = String(x.id === p.activeRoleId);
        const name = document.createElement('span');
        name.className = 'roles-list-name';
        name.textContent = x.name;
        const meta = document.createElement('span');
        meta.className = 'roles-list-meta';
        meta.textContent = x.id === p.activeRoleId ? `active · v${x.activeVersion}` : `v${x.activeVersion}`;
        item.append(name, meta);
        els.rolesList.appendChild(item);
      }

      els.roleEmpty.dataset.show = String(!r);
      els.roleCard.dataset.show = String(!!r);
      if (!r) return;
      els.roleName.textContent = r.name;
      const isActive = r.id === p.activeRoleId;
      els.roleActiveBadge.dataset.show = String(isActive);
      els.roleActivate.dataset.show = String(!isActive);
      renderVersion();
    }

    function renderVersion() {
      const r = viewedRole();
      if (!r) return;
      const latest = latestN(r);
      const n = settingsUi.versionN;
      fillSelect(els.versionSelect, [...r.versions].sort((a, b) => b.n - a.n).map((v) => ({
        value: String(v.n),
        label: `v${v.n}${v.n === r.activeVersion ? ' · in use' : ''}`,
      })), String(n));
      const frozen = isFrozen(r, n);
      const inUse = n === r.activeVersion;
      els.versionState.dataset.state = frozen ? 'frozen' : 'editable';
      els.versionState.textContent = frozen ? 'Frozen' : 'Editable';
      els.fRoleText.value = versionOf(r, n)?.text ?? '';
      els.fRoleText.readOnly = frozen;
      els.versionUse.disabled = inUse;
      els.versionHint.textContent = frozen
        ? `v${n} is frozen. “New version” copies it into v${latest + 1} to edit.`
        : inUse
          ? 'Calls use this version. Applies to your next call.'
          : `Calls still use v${r.activeVersion} — press “Use this version” to switch.`;
    }

    function selectSettingsTab(tab, focus = false) {
      if (!TABS.includes(tab)) tab = 'roles';
      els.settingsView.dataset.tab = tab;
      els.settingsView.querySelectorAll('.settings-tab').forEach((b) => {
        const on = b.dataset.tab === tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      els.settingsView.querySelectorAll('.settings-panel').forEach((panel) => {
        panel.dataset.active = String(panel.dataset.panel === tab);
      });
      try { localStorage.setItem(TAB_KEY, tab); } catch { /* storage blocked — not needed */ }
    }

    function openSettings(tab) {
      draft = JSON.parse(JSON.stringify(store));
      settingsUi.roleId = null;
      settingsUi.versionN = null;
      renderGlobalFields();
      renderProfileBar();
      renderProfileFields();
      renderRoles();
      closeMenus();
      hideInline();
      setSettingsConfirm(false);
      closeSidebar();
      closeMcpBar();
      let remembered = null;
      try { remembered = localStorage.getItem(TAB_KEY); } catch { /* storage blocked */ }
      selectSettingsTab(tab ?? remembered ?? 'roles');
      els.appEl.dataset.view = 'settings';
      const body = els.settingsView.querySelector('.settings-body');
      if (body) body.scrollTop = 0;
      els.settingsView.querySelector('[data-action="settings-close"]')?.focus();
    }

    function isSettingsOpen() { return els.appEl?.dataset.view === 'settings'; }

    function closeSettings() {
      if (!isSettingsOpen()) return;
      els.appEl.dataset.view = 'chat';
      setSettingsConfirm(false);
      closeMenus();
      hideInline();
      draft = null;
      els.settingsBtn?.focus();
    }

    /** Footer mode: normal (Cancel/Save) or the discard prompt. */
    function setSettingsConfirm(on) {
      if (!els.settingsFoot) return;
      els.settingsFoot.dataset.confirm = String(on);
      if (on) els.settingsFoot.querySelector('[data-action="settings-keep"]')?.focus();
    }

    /** Before enumeration finishes a device select holds only "System
     * default" — read the saved id then, or a quick Save would reset it. */
    function deviceValue(sel, saved) {
      return sel.options.length > 1 ? sel.value : (saved ?? '');
    }

    function isSettingsDirty() {
      pullForm();
      return canonicalStore(draft) !== canonicalStore(store);
    }

    /** Back / Cancel / Escape: leave directly, or ask first if edits would be lost. */
    function requestCloseSettings() {
      if (els.settingsFoot?.dataset.confirm === 'true' || !isSettingsDirty()) closeSettings();
      else setSettingsConfirm(true);
    }

    function saveSettings() {
      pullForm();
      for (const p of draft.profiles) {
        for (const r of p.roles) for (const v of r.versions) v.text = (v.text ?? '').trim();
      }
      store = draft;
      config = resolveConfig(store, DEFAULTS);
      // Close immediately — never block the view on the network round-trip.
      // The in-memory config is already updated and is what a call uses; the
      // KV write only matters for persistence across reloads.
      closeSettings();
      systemLine(`Settings saved — next call: ${describeSetup()}`, 'info');
      renderMcpBadge();
      renderMcpBar();
      if (config.vadMode === 'browser') warmSilero();
      saveConfig().then((ok) => {
        if (ok === false) systemLine('Kept for this session, but could not persist settings.', 'error');
      });
    }

    // ── Settings: ⋯ menus and the inline rename / delete bar ────────────────
    function closeMenus() {
      els.settingsView?.querySelectorAll('.settings-menu[data-open="true"]').forEach((m) => { m.dataset.open = 'false'; });
      els.settingsView?.querySelectorAll('[data-action="menu-toggle"]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    }

    function toggleMenu(btn) {
      const panel = els.settingsView.querySelector(`[data-menu-panel="${btn.dataset.menu}"]`);
      const open = panel?.dataset.open !== 'true';
      closeMenus();
      if (!panel || !open) return;
      panel.dataset.open = 'true';
      btn.setAttribute('aria-expanded', 'true');
      panel.querySelector('.menu-item:not(:disabled)')?.focus();
    }

    let inlineAction = null; // what the inline bar's OK does

    /** mode 'rename' shows a name input; mode 'confirm' just a message. */
    function showInline(which, { mode, message, value = '', okLabel, danger = false, onOk }) {
      hideInline();
      const bar = els.settingsView.querySelector(`[data-inline="${which}"]`);
      if (!bar) return;
      bar.dataset.mode = mode;
      bar.querySelector('.inline-bar-msg').textContent = message;
      const ok = bar.querySelector('.inline-bar-ok');
      ok.textContent = okLabel;
      ok.dataset.danger = String(danger);
      inlineAction = onOk;
      const input = bar.querySelector('.inline-bar-input');
      if (mode === 'rename') { input.value = value; input.focus(); input.select(); } else ok.focus();
    }

    function hideInline() {
      els.settingsView?.querySelectorAll('.inline-bar').forEach((b) => { b.dataset.mode = 'none'; });
      inlineAction = null;
    }

    function runInline(bar) {
      pullForm(); // the action re-renders the editor — keep unsaved text
      const action = inlineAction;
      const name = bar.querySelector('.inline-bar-input').value.trim();
      if (bar.dataset.mode === 'rename' && !name) { bar.querySelector('.inline-bar-input').focus(); return; }
      hideInline();
      action?.(name);
    }

    function renameProfile() {
      const p = draftProfile();
      showInline('profile', {
        mode: 'rename', message: 'Profile name', value: p.name, okLabel: 'Rename',
        onOk: (name) => { p.name = name; renderProfileBar(); },
      });
    }

    function renameRole() {
      const r = viewedRole();
      if (!r) return;
      showInline('role', {
        mode: 'rename', message: 'Role name', value: r.name, okLabel: 'Rename',
        onOk: (name) => { r.name = name; renderRoles(); },
      });
    }

    /** Switch profile/role in the draft: save the form into the old one first. */
    function switchProfile(id) {
      pullForm();
      draft.activeProfileId = id;
      settingsUi.roleId = null;
      settingsUi.versionN = null;
      hideInline();
      renderProfileBar();
      renderProfileFields();
      renderRoles();
    }

    function viewRole(id) {
      pullForm();
      settingsUi.roleId = id;
      settingsUi.versionN = null;
      hideInline();
      renderRoles();
    }

    function settingsAction(action) {
      if (!draft) return false; // e.g. Save's own listener already closed the view
      const p = draftProfile();
      const r = viewedRole();
      switch (action) {
        case 'profile-new':
        case 'profile-duplicate': {
          pullForm();
          const taken = draft.profiles.map((x) => x.name);
          const fresh = action === 'profile-new'
            ? blankProfile(uniqueName('New profile', taken), DEFAULTS)
            : duplicateProfile(p, uniqueName(`${p.name} copy`, taken));
          draft.profiles.push(fresh);
          switchProfile(fresh.id);
          renameProfile();
          break;
        }
        case 'profile-rename': renameProfile(); break;
        case 'profile-delete':
          if (draft.profiles.length < 2) break;
          showInline('profile', {
            mode: 'confirm', message: `Delete profile “${p.name}” and its ${p.roles.length} role(s)?`, okLabel: 'Delete', danger: true,
            onOk: () => {
              draft.profiles = draft.profiles.filter((x) => x.id !== p.id);
              draft.activeProfileId = draft.profiles[0].id;
              settingsUi.roleId = null;
              settingsUi.versionN = null;
              renderProfileBar();
              renderProfileFields();
              renderRoles();
            },
          });
          break;
        case 'role-new':
        case 'role-duplicate': {
          pullForm();
          const taken = p.roles.map((x) => x.name);
          const fresh = action === 'role-new' || !r
            ? newRole(uniqueName('New role', taken))
            : newRole(uniqueName(`${r.name} copy`, taken), versionOf(r, settingsUi.versionN)?.text ?? '');
          p.roles.push(fresh);
          if (!p.activeRoleId) p.activeRoleId = fresh.id;
          settingsUi.roleId = fresh.id;
          settingsUi.versionN = null;
          renderRoles();
          renameRole();
          break;
        }
        case 'role-rename': renameRole(); break;
        case 'role-activate':
          if (r) { pullForm(); p.activeRoleId = r.id; renderRoles(); }
          break;
        case 'role-delete':
          if (!r) break;
          showInline('role', {
            mode: 'confirm', message: `Delete role “${r.name}” and its ${r.versions.length} version(s)?`, okLabel: 'Delete', danger: true,
            onOk: () => {
              p.roles = p.roles.filter((x) => x.id !== r.id);
              if (p.activeRoleId === r.id) p.activeRoleId = p.roles[0]?.id ?? null;
              settingsUi.roleId = null;
              settingsUi.versionN = null;
              renderRoles();
            },
          });
          break;
        case 'version-new':
          if (!r) break;
          pullForm();
          settingsUi.versionN = addVersion(r, settingsUi.versionN);
          renderVersion();
          els.fRoleText.focus();
          break;
        case 'version-use':
          if (!r) break;
          pullForm();
          r.activeVersion = settingsUi.versionN;
          renderRoles();
          break;
        default: return false;
      }
      return true;
    }

    // ── Conversations sidebar (overlay drawer) ──────────────────────────────
    function isSidebarOpen() { return els.appEl?.dataset.sidebar === 'open'; }
    function openSidebar() { closeMcpBar(); if (els.appEl) els.appEl.dataset.sidebar = 'open'; refreshConvList(); }
    function closeSidebar() { if (els.appEl) els.appEl.dataset.sidebar = 'closed'; }
    function toggleSidebar() { if (isSidebarOpen()) closeSidebar(); else openSidebar(); }

    // ── MCP servers drawer (right overlay) + header badge ───────────────────
    function isMcpBarOpen() { return els.appEl?.dataset.mcpbar === 'open'; }
    function openMcpBar() {
      closeSidebar();
      renderMcpBar();
      if (els.appEl) els.appEl.dataset.mcpbar = 'open';
      // Outside a call there is no WS to push changes, so poll the record.
      refreshTempServers();
      if (!mcpPollTimer) mcpPollTimer = setInterval(refreshTempServers, 3000);
    }
    function setMcpInfo(open) {
      if (!els.mcpbarInfo) return;
      els.mcpbarInfo.dataset.open = String(open);
      els.mcpbarInfoBtn?.setAttribute('aria-expanded', String(open));
    }
    function closeMcpBar() {
      if (els.appEl) els.appEl.dataset.mcpbar = 'closed';
      setMcpInfo(false);
      if (mcpPollTimer) { clearInterval(mcpPollTimer); mcpPollTimer = null; }
    }
    function toggleMcpBar() { if (isMcpBarOpen()) closeMcpBar(); else openMcpBar(); }

    /** Every server this conversation can use: Settings ones first, then the
     * conversation's temporary ones (a temporary URL that duplicates a
     * configured one is ignored — Settings wins, same rule as the server). */
    function mcpServers() {
      const out = [];
      const seen = new Set();
      for (const s of config.mcpServers ?? []) {
        if (!s?.url || seen.has(s.url)) continue;
        seen.add(s.url);
        out.push({ url: s.url, transport: s.transport ?? 'http', name: '', temporary: false, behavior: s.behavior === 'blocking' ? 'blocking' : 'non-blocking' });
      }
      for (const t of tempServers) {
        if (!t?.url || seen.has(t.url)) continue;
        seen.add(t.url);
        out.push({ url: t.url, transport: t.transport ?? 'http', name: t.name ?? '', temporary: true, behavior: t.behavior === 'blocking' ? 'blocking' : 'non-blocking' });
      }
      return out;
    }

    /** Re-read the active conversation's temporary servers (no call → no WS). */
    async function refreshTempServers() {
      if (!activeConversationId || inCall) return;
      try {
        const res = await fetch(`api/conversations/${activeConversationId}`, { cache: 'no-store' });
        if (!res.ok) return;
        const conv = await res.json();
        const next = Array.isArray(conv.mcpTemporary) ? conv.mcpTemporary : [];
        if (JSON.stringify(next) !== JSON.stringify(tempServers)) { tempServers = next; renderMcpBar(); }
      } catch (err) {
        console.error('[callgemini] temporary server refresh failed:', err);
      }
    }

    /** "host/path" for a server URL — enough to tell servers apart in a row. */
    function mcpDisplayName(url) {
      try {
        const u = new URL(url);
        return `${u.host}${u.pathname === '/' ? '' : u.pathname}`;
      } catch { return url; }
    }

    /** Header badge: enabled/total, tinted when something is being skipped. */
    function renderMcpBadge() {
      if (!els.mcpBadge) return;
      const servers = mcpServers();
      const enabled = servers.filter((s) => !mcpDisabled.has(s.url));
      const skipping = enabled.some((s) => mcpSkipped.has(s.url));
      els.mcpBadgeText.textContent = `${enabled.length}/${servers.length}`;
      els.mcpBadge.dataset.empty = String(servers.length === 0);
      els.mcpBadge.dataset.skipping = String(skipping);
      els.mcpBadge.title = servers.length
        ? `${enabled.length} of ${servers.length} MCP server(s) enabled${skipping ? ' · some skipped' : ''}`
        : 'No MCP servers configured';
    }

    /** Rows are runtime DOM (createElement), so their styles are global. */
    function renderMcpBar() {
      renderMcpBadge();
      if (!els.mcpToggleList) return;
      els.mcpToggleList.textContent = '';
      const servers = mcpServers();
      const groupTitle = (text) => {
        const h = document.createElement('div');
        h.className = 'mcp-group-title';
        h.textContent = text;
        els.mcpToggleList.appendChild(h);
      };
      const emptyRow = (text) => {
        const empty = document.createElement('div');
        empty.className = 'mcp-toggle-empty';
        empty.textContent = text;
        els.mcpToggleList.appendChild(empty);
      };
      groupTitle('Configured (Settings)');
      if (!servers.some((s) => !s.temporary)) emptyRow('No MCP servers configured yet.');
      for (const srv of servers.filter((s) => !s.temporary)) els.mcpToggleList.appendChild(mcpRow(srv));
      groupTitle('Temporary');
      if (!servers.some((s) => s.temporary)) {
        emptyRow(activeConversationId
          ? 'None for this conversation. Other apps add them through the CallGemini MCP server (add_mcp_server).'
          : 'Start or load a conversation first — temporary servers belong to one conversation.');
      }
      for (const srv of servers.filter((s) => s.temporary)) els.mcpToggleList.appendChild(mcpRow(srv));
    }

    /** One server row: name/meta, ON/OFF switch, Skip, and X for temporary ones. */
    function mcpRow(srv) {
      {
        const on = !mcpDisabled.has(srv.url);
        const skip = mcpSkipped.has(srv.url);
        const live = mcpLive.get(srv.url);

        const row = document.createElement('div');
        row.className = 'mcp-toggle-row';
        row.dataset.url = srv.url;
        row.dataset.on = String(on);
        row.dataset.temporary = String(!!srv.temporary);

        const main = document.createElement('div');
        main.className = 'mcp-toggle-main';
        const name = document.createElement('div');
        name.className = 'mcp-toggle-name';
        name.textContent = srv.name || mcpDisplayName(srv.url);
        name.title = srv.url;
        const meta = document.createElement('div');
        meta.className = 'mcp-toggle-meta';
        let state = 'idle';
        let info;
        if (!on) info = 'off';
        else if (live?.error) { state = 'failed'; info = `connect failed: ${live.error}`; }
        else if (live?.ok) info = `${live.tools} tool${live.tools === 1 ? '' : 's'}${skip ? ' · skipping' : ''}`;
        else if (skip) { state = 'skipping'; info = 'skipping'; }
        else info = inCall ? 'connecting…' : 'on';
        meta.dataset.state = state;
        meta.textContent = `${(srv.transport ?? 'http').toUpperCase()} · ${info}`;
        main.append(name, meta);

        const onoff = document.createElement('button');
        onoff.type = 'button';
        onoff.className = 'mcp-switch';
        onoff.dataset.action = 'mcp-onoff';
        onoff.dataset.on = String(on);
        onoff.setAttribute('role', 'switch');
        onoff.setAttribute('aria-checked', String(on));
        onoff.textContent = on ? 'ON' : 'OFF';
        onoff.title = on ? 'Turn off for this conversation' : 'Turn on for this conversation';

        const skipBtn = document.createElement('button');
        skipBtn.type = 'button';
        skipBtn.className = 'mcp-skip';
        skipBtn.dataset.action = 'mcp-skip';
        skipBtn.dataset.on = String(skip);
        skipBtn.disabled = !on;
        skipBtn.textContent = 'Skip';
        skipBtn.title = skip ? 'Calls are being skipped — click to run them again' : 'Keep the tools visible but skip every call';

        row.append(main, onoff, skipBtn);
        if (srv.temporary) {
          const rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'mcp-remove';
          rm.dataset.action = 'mcp-remove';
          rm.setAttribute('aria-label', 'Remove temporary server');
          rm.title = 'Remove from this conversation';
          rm.appendChild(icon(X, 14));
          row.appendChild(rm);
        }
        return row;
      }
    }

    /** X on a temporary row: drop it from the conversation (re-dials a live call). */
    async function removeTempServer(url) {
      tempServers = tempServers.filter((t) => t.url !== url);
      renderMcpBar();
      if (inCall && ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'mcp', disabled: [...mcpDisabled], skipped: [...mcpSkipped], temporary: tempServers }));
        systemLine('Removing temporary server — Gemini is being reconnected…', 'info');
        return;
      }
      if (!activeConversationId) return;
      try {
        const res = await fetch(`api/conversations/${activeConversationId}`, {
          method: 'PATCH', cache: 'no-store',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mcpTemporary: tempServers }),
        });
        if (!res.ok) { systemLine(`Could not remove the temporary server (${res.status})`, 'error'); await refreshTempServers(); return; }
        const conv = await res.json();
        tempServers = Array.isArray(conv.mcpTemporary) ? conv.mcpTemporary : [];
        renderMcpBar();
      } catch (err) {
        console.error('[callgemini] temporary server remove failed:', err);
        systemLine('Could not remove the temporary server', 'error');
        await refreshTempServers();
      }
    }

    /**
     * Push the toggle state where it lives: over the WS during a call (the
     * server persists it and applies it live), via PATCH for a saved
     * conversation that is not in a call, and nowhere for a not-yet-started
     * chat — the start frame carries it then.
     */
    async function persistMcpState() {
      const body = { mcpDisabled: [...mcpDisabled], mcpSkipped: [...mcpSkipped] };
      if (inCall && ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({ type: 'mcp', disabled: body.mcpDisabled, skipped: body.mcpSkipped }));
        return;
      }
      if (!activeConversationId) return;
      try {
        const res = await fetch(`api/conversations/${activeConversationId}`, {
          method: 'PATCH', cache: 'no-store',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!res.ok) systemLine(`Could not save the MCP toggles (${res.status})`, 'error');
      } catch (err) {
        console.error('[callgemini] mcp state save failed:', err);
        systemLine('Could not save the MCP toggles', 'error');
      }
    }

    function applyConversationMcp(conv) {
      mcpDisabled = new Set(Array.isArray(conv?.mcpDisabled) ? conv.mcpDisabled : []);
      mcpSkipped = new Set(Array.isArray(conv?.mcpSkipped) ? conv.mcpSkipped : []);
      tempServers = Array.isArray(conv?.mcpTemporary) ? conv.mcpTemporary : [];
      renderMcpBar();
    }

    function resetMcpState() {
      mcpDisabled = new Set();
      mcpSkipped = new Set();
      tempServers = [];
      mcpLive.clear();
      renderMcpBar();
    }

    function relativeTime(ts) {
      if (!ts) return '';
      const s = Math.floor((Date.now() - ts) / 1000);
      if (s < 60) return 'just now';
      const m = Math.floor(s / 60); if (m < 60) return `${m}m ago`;
      const h = Math.floor(m / 60); if (h < 24) return `${h}h ago`;
      const d = Math.floor(h / 24); if (d < 7) return `${d}d ago`;
      return new Date(ts).toLocaleDateString();
    }

    function updateActiveConvHighlight() {
      els.convList?.querySelectorAll('.conv-item').forEach((el) => {
        if (el.dataset.id === activeConversationId) el.dataset.active = 'true';
        else delete el.dataset.active;
      });
    }

    /** Placeholder row, shown whenever the list holds no conversations. */
    function showConvEmpty() {
      if (!els.convList || els.convList.querySelector('.conv-empty')) return;
      const empty = document.createElement('div');
      empty.className = 'conv-empty';
      empty.textContent = 'No conversations yet';
      els.convList.appendChild(empty);
    }

    function renderConvList(items) {
      els.convList.textContent = '';
      if (!items.length) { showConvEmpty(); return; }
      for (const it of items) {
        const row = document.createElement('div');
        row.className = 'conv-item';
        row.dataset.id = it.id;
        if (it.id === activeConversationId) row.dataset.active = 'true';

        const main = document.createElement('div');
        main.className = 'conv-main';
        const title = document.createElement('div');
        title.className = 'conv-title';
        title.textContent = it.title || 'New conversation';
        const time = document.createElement('div');
        time.className = 'conv-time';
        time.textContent = relativeTime(it.updatedAt);
        main.append(title, time);

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'conv-del';
        del.dataset.action = 'conv-del';
        del.setAttribute('aria-label', 'Delete');
        del.appendChild(icon(Trash2, 16));

        // Inline delete confirmation, shown in place of the row (No / Yes).
        const confirm = document.createElement('div');
        confirm.className = 'conv-confirm';
        const q = document.createElement('span');
        q.className = 'conv-confirm-q';
        q.textContent = 'Delete?';
        const no = document.createElement('button');
        no.type = 'button'; no.className = 'conv-confirm-no'; no.dataset.action = 'conv-del-no';
        no.textContent = 'No';
        const yes = document.createElement('button');
        yes.type = 'button'; yes.className = 'conv-confirm-yes'; yes.dataset.action = 'conv-del-yes';
        yes.textContent = 'Yes';
        confirm.append(q, yes, no);

        row.append(main, del, confirm);
        els.convList.appendChild(row);
      }
    }

    async function loadConvList() {
      // `no-store`: a cached 200 here would resurrect a row we just deleted.
      try {
        const res = await fetch('api/conversations', { cache: 'no-store' });
        if (!res.ok) { systemLine(`Could not refresh the conversation list (${res.status})`, 'error'); return; }
        renderConvList(await res.json());
      } catch (err) {
        console.error('[callgemini] conversation list refresh failed:', err);
        systemLine('Could not refresh the conversation list', 'error');
      }
    }

    async function refreshConvList() {
      // Don't yank a row out from under an open delete confirmation (background
      // refresh only — an explicit delete re-renders through loadConvList()).
      if (els.convList?.querySelector('.conv-item[data-confirm="true"]')) return;
      await loadConvList();
    }

    // Debounced refresh while a call streams turns (title/order change server-side).
    function scheduleConvRefresh() {
      if (convRefreshTimer) return;
      convRefreshTimer = setTimeout(() => {
        convRefreshTimer = null;
        if (isSidebarOpen()) refreshConvList();
      }, 1500);
    }

    function showEmptyState() {
      els.transcript.innerHTML =
        '<div class="cg-empty" data-role="empty">' +
        '<p class="cg-empty-title">Press <strong>Call</strong> to talk to Gemini.</p>' +
        '<p class="cg-empty-sub">The conversation is transcribed here live. Configure your API key and MCP tools with the ⚙ button.</p>' +
        '</div>';
    }

    function clearTranscript() {
      els.transcript.innerHTML = '';
      activeBubbles.user = null; activeBubbles.model = null;
      pendingText.user = ''; pendingText.model = '';
      toolChips.clear();
    }

    async function loadConversation(id) {
      if (inCall) endCall('load-history');
      try {
        const res = await fetch(`api/conversations/${id}`);
        if (!res.ok) { systemLine('Could not load that conversation', 'error'); return; }
        const conv = await res.json();
        clearTranscript();
        for (const t of conv.turns ?? []) {
          const b = createBubble(t.role);
          b.textEl.textContent = t.text;
        }
        activeConversationId = id;
        applyConversationMcp(conv);
        setStatus('idle');
        systemLine('Loaded — press Call to continue this conversation', 'info');
        closeSidebar();
        updateActiveConvHighlight();
      } catch {
        systemLine('Could not load that conversation', 'error');
      }
    }

    function newChat({ keepSidebar = false } = {}) {
      if (inCall) endCall('new-chat');
      activeConversationId = null;
      resetMcpState(); // a fresh chat starts with every server ON
      showEmptyState();
      activeBubbles.user = null; activeBubbles.model = null; toolChips.clear();
      pendingText.user = ''; pendingText.model = '';
      setStatus('idle');
      if (!keepSidebar) closeSidebar();
      updateActiveConvHighlight();
    }

    /** Drop the on-screen conversation without touching the sidebar. */
    function unloadActiveConversation() {
      try { if (inCall) endCall('delete'); } catch (err) { console.error(err); }
      activeConversationId = null;
      resetMcpState();
      showEmptyState();
      activeBubbles.user = null; activeBubbles.model = null; toolChips.clear();
      pendingText.user = ''; pendingText.model = '';
      setStatus('idle');
    }

    async function deleteConversation(id) {
      const wasActive = id === activeConversationId;

      // The row (and the Yes/No question standing in its place) goes away on
      // the click itself — NOT on the DELETE round-trip and not on the list GET
      // that follows it. Either request can fail, be cached, or never resolve;
      // when the visible update hangs off them, that reads as "Yes does
      // nothing". The list GET below is reconciliation only, so a delete that
      // did not reach the server puts the row back.
      const row = [...(els.convList?.querySelectorAll('.conv-item') ?? [])].find((r) => r.dataset.id === id);
      row?.remove();
      if (!els.convList?.querySelector('.conv-item')) showConvEmpty();
      if (wasActive) unloadActiveConversation();

      try {
        const res = await fetch(`api/conversations/${id}`, { method: 'DELETE', cache: 'no-store' });
        if (!res.ok) systemLine(`Could not delete that conversation (${res.status})`, 'error');
      } catch (err) {
        console.error('[callgemini] delete request failed:', err);
        systemLine('Could not delete that conversation', 'error');
      }

      await loadConvList();
    }

    els.toggleSidebarBtn?.addEventListener('click', toggleSidebar);
    els.newChatBtn?.addEventListener('click', () => newChat());
    els.backdrop?.addEventListener('click', () => { closeSidebar(); closeMcpBar(); });
    els.mcpBadge?.addEventListener('click', toggleMcpBar);
    els.mcpbarClose?.addEventListener('click', closeMcpBar);
    els.mcpbarInfoBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setMcpInfo(els.mcpbarInfo?.dataset.open !== 'true');
    });
    // Any click outside the popover (or Escape) dismisses it.
    document.addEventListener('click', (e) => {
      if (els.mcpbarInfo?.dataset.open === 'true' && !e.target.closest('[data-role="mcpbar-info"]')) setMcpInfo(false);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMcpInfo(false); });
    els.mcpbarSettings?.addEventListener('click', () => { closeMcpBar(); openSettings('integrations'); });
    // Delegated toggles for the runtime-rendered MCP rows.
    els.mcpToggleList?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-action="mcp-onoff"], [data-action="mcp-skip"], [data-action="mcp-remove"]');
      const url = btn?.closest('.mcp-toggle-row')?.dataset.url;
      if (!btn || !url) return;
      if (btn.dataset.action === 'mcp-remove') { removeTempServer(url); return; }
      if (btn.dataset.action === 'mcp-onoff') {
        if (mcpDisabled.has(url)) mcpDisabled.delete(url); else mcpDisabled.add(url);
        if (inCall) systemLine('Updating tools — Gemini is being reconnected…', 'info');
      } else if (mcpSkipped.has(url)) mcpSkipped.delete(url);
      else mcpSkipped.add(url);
      renderMcpBar();
      persistMcpState();
    });
    els.convList?.addEventListener('click', (e) => {
      const item = e.target.closest('.conv-item');
      if (!item) return;
      const id = item.dataset.id;
      // Delete flow: trash → inline confirm (No / Yes) in place of the row.
      if (e.target.closest('[data-action="conv-del-yes"]')) { e.stopPropagation(); deleteConversation(id); return; }
      if (e.target.closest('[data-action="conv-del-no"]')) { e.stopPropagation(); item.dataset.confirm = 'false'; return; }
      if (e.target.closest('[data-action="conv-del"]')) {
        e.stopPropagation();
        els.convList.querySelectorAll('.conv-item[data-confirm="true"]').forEach((r) => { r.dataset.confirm = 'false'; });
        item.dataset.confirm = 'true';
        return;
      }
      if (item.dataset.confirm === 'true') return; // don't load while awaiting a Yes/No
      loadConversation(id);
    });

    els.callBtn?.addEventListener('click', toggleCall);
    els.muteBtn?.addEventListener('click', toggleMute);
    els.speakerBtn?.addEventListener('click', toggleSpeaker);
    els.volSlider?.addEventListener('input', () => {
      config.volume = Number(els.volSlider.value);
      store.global.volume = config.volume;
      // Dragging the slider means "I want to hear it": unsilence at the new level.
      if (speakerMuted) setSpeakerMuted(false);
      renderVolume();
      applyVolume();
      // Persist AFTER the drag settles — one KV write, not one per tick.
      clearTimeout(volSaveTimer);
      volSaveTimer = setTimeout(() => saveConfig(), 600);
    });
    els.settingsBtn?.addEventListener('click', () => openSettings());
    // Plug/unplug while settings are open → refresh the device dropdowns.
    navigator.mediaDevices?.addEventListener?.('devicechange', () => {
      if (isSettingsOpen()) void populateDeviceSelects();
    });
    els.settingsSave?.addEventListener('click', saveSettings);
    els.fModelPreset?.addEventListener('change', syncModelCustomVisibility);
    // ACP "Discover": ask the OS registry for live ACP interfaces and take the
    // first one's address (absolute → shell route, same origin as the app).
    els.acpDiscover?.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/interfaces?kind=acp&live=1');
        const data = res.ok ? await res.json() : null;
        const iface = (data?.interfaces ?? []).find((i) => i?.address);
        if (iface) {
          els.fAcpAddress.value = iface.address;
        } else {
          systemLine('No live ACP interface found.', 'info');
        }
      } catch (err) {
        systemLine(`ACP discovery failed: ${err?.message ?? err}`, 'error');
      }
    });
    // All settings buttons are delegated on the view (several share an action,
    // e.g. the two "settings-close" and the two "role-new" buttons).
    els.settingsView?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-action]');
      if (!e.target.closest('.menu-anchor')) closeMenus();
      if (!btn || btn.disabled) return;
      const action = btn.dataset.action;
      if (action === 'settings-close') requestCloseSettings();
      else if (action === 'settings-keep') setSettingsConfirm(false);
      else if (action === 'settings-discard') closeSettings();
      else if (action === 'menu-toggle') toggleMenu(btn);
      else if (action === 'inline-ok') runInline(btn.closest('.inline-bar'));
      else if (action === 'inline-cancel') hideInline();
      else if (settingsAction(action)) closeMenus();
    });
    els.settingsView?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.closest('.inline-bar-input')) {
        e.preventDefault();
        runInline(e.target.closest('.inline-bar'));
        return;
      }
      if (e.key !== 'Escape') return;
      e.preventDefault();
      // Innermost first: menu → inline bar → discard prompt → leave.
      if (els.settingsView.querySelector('.settings-menu[data-open="true"]')) closeMenus();
      else if (els.settingsView.querySelector('.inline-bar:not([data-mode="none"])')) hideInline();
      else if (els.settingsFoot?.dataset.confirm === 'true') setSettingsConfirm(false);
      else requestCloseSettings();
    });
    els.profileSelect?.addEventListener('change', () => switchProfile(els.profileSelect.value));
    els.roleSelect?.addEventListener('change', () => viewRole(els.roleSelect.value));
    els.rolesList?.addEventListener('click', (e) => {
      const item = e.target.closest('.roles-list-item[data-role-id]');
      if (item) viewRole(item.dataset.roleId);
    });
    els.versionSelect?.addEventListener('change', () => {
      pullForm();
      settingsUi.versionN = Number(els.versionSelect.value);
      renderVersion();
    });
    // Tabs: click, plus ←/→/Home/End between them (roving tabindex).
    els.settingsTabs?.addEventListener('click', (e) => {
      const tab = e.target.closest('.settings-tab');
      if (tab) selectSettingsTab(tab.dataset.tab);
    });
    els.settingsTabs?.addEventListener('keydown', (e) => {
      const i = TABS.indexOf(els.settingsView.dataset.tab);
      const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: TABS.length - 1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      selectSettingsTab(TABS[(next + TABS.length) % TABS.length], true);
    });
    els.mcpAdd?.addEventListener('click', () => {
      renderMcpRows([...readMcpRows(), { url: '', transport: 'http' }]);
    });
    // Language chips: toggle a language, or "Any" to clear all → auto-detect.
    els.langChips?.addEventListener('click', (e) => {
      const chip = e.target.closest('.lang-chip');
      if (!chip) return;
      if (chip.dataset.lang === '') {
        // "Any" → turn every specific language off.
        els.langChips.querySelectorAll('.lang-chip[data-lang]').forEach((c) => {
          if (c.dataset.lang) c.dataset.on = 'false';
        });
        chip.dataset.on = 'true';
        return;
      }
      chip.dataset.on = String(chip.dataset.on !== 'true');
      syncAnyChip();
    });
    // Delegated remove for dynamically-rendered MCP rows.
    els.mcpList?.addEventListener('click', (e) => {
      // Drop the row itself: readMcpRows() skips blank rows, so an index
      // into it would point at the wrong server.
      e.target.closest('[data-action="mcp-del"]')?.closest('.mcp-row')?.remove();
    });
    els.textForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = els.textInput.value.trim();
      if (!text) return;
      if (!inCall) { systemLine('Start a call to send a message', 'error'); return; }
      ws?.send(JSON.stringify({ type: 'text', text }));
      els.textInput.value = '';
    });

    // OS keymap actions + Back. Dynamically imported so an SDK resolution
    // hiccup can't break the (already-wired) core controller. The bare
    // specifier resolves to a /node_modules|@fs URL the proxy DOES rewrite.
    import('@aura/app-sdk').then(({ OsClient }) => {
      const osClient = new OsClient();
      osClient.keymap.on('toggle-call', toggleCall);
      osClient.keymap.on('mute', toggleMute);
      osClient.keymap.on('mute-speaker', toggleSpeaker);
      osClient.keymap.on('toggle-conversations', toggleSidebar);
      osClient.nav.onBack((e) => {
        // Back leaves settings first; only from the chat does it end a call.
        if (isSettingsOpen()) { e.preventDefault(); requestCloseSettings(); return; }
        if (inCall) { e.preventDefault(); endCall('os-back'); }
      });
    }).catch(() => { /* running outside the OS shell */ });

    // Boot.
    mountIcons();
    setStatus('idle');
    updateControls();
    renderVolume();
    renderMcpBar();
    loadConfig().then(() => {
      renderMcpBar();
      if (!config.apiKey && !window.GEMINI_API_KEY_PRESENT) {
        systemLine('No Gemini API key set. Open Settings (⚙) to add one, or set GEMINI_API_KEY in AuraOS Context.', 'info');
      }
      // Warm Silero in the background so the first call doesn't wait on the
      // ~16 MB download + session build (startCall hot-swaps if it's not done).
      if ((config.vadMode ?? DEFAULTS.vadMode) === 'browser') warmSilero();
      renderVolume();
    });
  </script>

  <!--
    Transcript rows, tool chips and MCP setting rows are created at runtime by
    call.js (createElement, not innerHTML), so their styles MUST be global —
    Astro's scoped `data-astro-cid-*` attribute is never stamped on runtime DOM.
    Everything is namespaced under `.cg-app` to avoid leaking into OS chrome.
  -->
  <style is:global>
    :root { color-scheme: light dark; }
    html, body { margin: 0; height: 100%; }
    body {
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: var(--aura-color-bg);
      color: var(--aura-color-text);
    }

    .cg-app {
      display: flex;
      flex-direction: column;
      height: 100vh;
      background: var(--aura-color-bg);
      color: var(--aura-color-text);
      position: relative;   /* positioning context for the overlay drawer */
      overflow: hidden;
    }

    /* ── Conversations drawer (overlay) ─────────────────────────────────── */
    .cg-sidebar {
      position: absolute; top: 0; left: 0; bottom: 0; z-index: 30;
      width: 260px; max-width: 84%;
      display: flex; flex-direction: column; gap: 8px;
      padding: 12px; box-sizing: border-box;
      background: var(--aura-color-surface);
      border-right: 1px solid var(--aura-color-border);
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .cg-app[data-sidebar="open"] .cg-sidebar { transform: translateX(0); }
    .cg-backdrop {
      position: absolute; inset: 0; z-index: 20;
      background: color-mix(in srgb, var(--aura-color-bg) 55%, transparent);
      opacity: 0; pointer-events: none; transition: opacity 0.2s ease;
    }
    .cg-app[data-sidebar="open"] .cg-backdrop,
    .cg-app[data-mcpbar="open"] .cg-backdrop { opacity: 1; pointer-events: auto; }

    /* ── MCP servers drawer (right overlay) ─────────────────────────────── */
    .cg-mcpbar {
      position: absolute; top: 0; right: 0; bottom: 0; z-index: 30;
      width: 300px; max-width: 88%;
      display: flex; flex-direction: column; gap: 10px;
      padding: 12px; box-sizing: border-box;
      background: var(--aura-color-surface);
      border-left: 1px solid var(--aura-color-border);
      transform: translateX(100%);
      transition: transform 0.2s ease;
    }
    .cg-app[data-mcpbar="open"] .cg-mcpbar { transform: translateX(0); }
    .mcpbar-head { display: flex; align-items: center; justify-content: space-between; position: relative; }
    .mcpbar-head-actions { display: flex; align-items: center; gap: 6px; }
    .mcpbar-title { font-weight: 600; font-size: 14px; }
    /* (i) popover — anchored under the header, above the list. */
    .mcpbar-info {
      display: none; position: absolute; top: calc(100% + 6px); left: 0; right: 0; z-index: 5;
      padding: 10px 12px; border-radius: 10px;
      background: var(--aura-color-surface-2); color: var(--aura-color-text-dim);
      border: 1px solid var(--aura-color-border); box-shadow: var(--aura-glow-subtle);
      font-size: 12px; line-height: 1.45;
    }
    .mcpbar-info[data-open="true"] { display: block; }
    .mcpbar-info p { margin: 0 0 6px; }
    .mcpbar-info p:last-child { margin-bottom: 0; }
    .mcpbar-info strong { color: var(--aura-color-text); }
    .mcpbar-head [aria-expanded="true"] { border-color: var(--aura-color-primary); color: var(--aura-color-primary); }
    .mcp-toggle-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; }
    .mcp-toggle-empty { color: var(--aura-color-text-dim); font-size: 13px; text-align: center; padding: 16px 8px; }
    .mcp-toggle-row {
      display: flex; align-items: center; gap: 6px;
      padding: 8px 10px; border-radius: 8px;
      border: 1px solid var(--aura-color-border);
      background: var(--aura-color-surface-2);
    }
    .mcp-toggle-row[data-on="false"] { opacity: 0.7; }
    .mcp-toggle-main { flex: 1; min-width: 0; }
    .mcp-toggle-name {
      font-size: 13px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .mcp-toggle-meta {
      font-size: 11px; color: var(--aura-color-text-dim);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .mcp-toggle-meta[data-state="failed"] { color: var(--aura-color-danger); }
    .mcp-toggle-meta[data-state="skipping"] { color: var(--aura-color-warning); }
    .mcp-switch, .mcp-skip {
      flex: 0 0 auto; font: inherit; font-size: 11px; font-weight: 700; cursor: pointer;
      padding: 4px 10px; border-radius: 999px; line-height: 1.3;
      border: 1px solid var(--aura-color-border);
      background: var(--aura-color-surface); color: var(--aura-color-text-dim);
    }
    .mcp-switch { min-width: 42px; }
    .mcp-group-title {
      font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--aura-color-text-dim); margin: 6px 2px 0;
    }
    .mcp-toggle-row[data-temporary="true"] { border-style: dashed; }
    .mcp-remove {
      flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; padding: 0; border-radius: 999px; cursor: pointer;
      border: 1px solid var(--aura-color-border); background: transparent; color: var(--aura-color-text-dim);
    }
    .mcp-remove:hover { color: var(--aura-color-danger); border-color: var(--aura-color-danger); }
    .mcp-switch[data-on="true"] { background: var(--aura-color-primary); color: var(--aura-color-bg); border-color: transparent; }
    .mcp-skip[data-on="true"] { background: var(--aura-color-warning); color: var(--aura-color-bg); border-color: transparent; }
    .mcp-skip:disabled { opacity: 0.4; cursor: default; }

    .new-chat-btn { width: 100%; text-align: left; display: flex; align-items: center; gap: 8px; }
    /* Lucide SVG icons: inherit currentColor, center inside their buttons. */
    .cg-app svg { display: block; flex: 0 0 auto; }
    .icon-btn, .btn-icon, .conv-del { display: inline-flex; align-items: center; justify-content: center; }
    .conv-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; }
    .conv-empty { color: var(--aura-color-text-dim); font-size: 13px; text-align: center; padding: 16px 8px; }
    .conv-item {
      display: flex; align-items: center; gap: 6px;
      padding: 8px 10px; border-radius: 8px; cursor: pointer;
      border: 1px solid transparent;
    }
    .conv-item:hover { background: var(--aura-color-surface-2); }
    .conv-item[data-active="true"] { background: var(--aura-color-surface-2); border-color: var(--aura-color-primary); }
    .conv-main { flex: 1; min-width: 0; }
    .conv-title {
      font-size: 13px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .conv-time { font-size: 11px; color: var(--aura-color-text-dim); }
    .conv-del {
      flex: 0 0 auto; font: inherit; font-size: 14px; line-height: 1; cursor: pointer;
      border: none; background: transparent; color: var(--aura-color-text-dim);
      padding: 4px 6px; border-radius: 6px; opacity: 0;
    }
    /* Trash appears on hover, and stays visible on the selected chat. */
    .conv-item:hover .conv-del,
    .conv-item[data-active="true"] .conv-del { opacity: 1; }
    .conv-del:hover { color: var(--aura-color-danger); background: var(--aura-color-surface); }

    /* Inline delete confirmation — replaces the row content in place. */
    .conv-confirm { display: none; flex: 1; align-items: center; gap: 6px; }
    .conv-item[data-confirm="true"] .conv-main,
    .conv-item[data-confirm="true"] .conv-del { display: none; }
    .conv-item[data-confirm="true"] .conv-confirm { display: flex; }
    .conv-confirm-q { flex: 1; min-width: 0; font-size: 13px; color: var(--aura-color-text-dim); }
    .conv-confirm-no, .conv-confirm-yes {
      flex: 0 0 auto; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
      padding: 4px 12px; border-radius: 6px; border: 1px solid var(--aura-color-border);
    }
    .conv-confirm-no { background: var(--aura-color-surface-2); color: var(--aura-color-text); }
    .conv-confirm-yes { background: var(--aura-color-danger); color: var(--aura-color-bg); border-color: transparent; }

    .cg-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--aura-color-border);
      background: var(--aura-color-surface);
    }
    .cg-header-left { display: flex; align-items: center; gap: 10px; }
    .icon-btn {
      font: inherit; font-size: 18px; line-height: 1; cursor: pointer;
      border: 1px solid var(--aura-color-border); border-radius: 8px;
      background: var(--aura-color-surface-2); color: var(--aura-color-text);
      padding: 5px 9px;
    }
    .icon-btn:hover { border-color: var(--aura-color-primary); }
    .cg-title { display: flex; align-items: center; gap: 10px; font-weight: 600; }
    .cg-logo {
      display: inline-grid; place-items: center;
      width: 28px; height: 28px; border-radius: 8px;
      background: var(--aura-color-primary); color: var(--aura-color-bg);
      font-size: 12px; font-weight: 700;
    }

    .status-pill {
      font-size: 12px; font-weight: 600;
      padding: 4px 10px; border-radius: 999px;
      background: var(--aura-color-surface-2); color: var(--aura-color-text-dim);
      border: 1px solid var(--aura-color-border);
    }
    .status-pill[data-state="live"] { background: var(--aura-color-success); color: var(--aura-color-bg); border-color: transparent; }
    .status-pill[data-state="connecting"] { background: var(--aura-color-info); color: var(--aura-color-bg); border-color: transparent; }
    .status-pill[data-state="reconnecting"] { background: var(--aura-color-warning); color: var(--aura-color-bg); border-color: transparent; }
    .status-pill[data-state="error"] { background: var(--aura-color-danger); color: var(--aura-color-bg); border-color: transparent; }

    .cg-header-right { display: flex; align-items: center; gap: 6px; }
    /* Header badge: enabled/total MCP servers for this conversation (opens the drawer). */
    .mcp-pill {
      font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
      display: inline-flex; align-items: center; gap: 5px; line-height: 1;
    }
    .mcp-pill:hover { border-color: var(--aura-color-primary); color: var(--aura-color-text); }
    .mcp-pill[data-empty="true"] { opacity: 0.6; }
    .mcp-pill[data-skipping="true"] { border-color: var(--aura-color-warning); color: var(--aura-color-warning); }
    .cg-app[data-mcpbar="open"] .mcp-pill { border-color: var(--aura-color-primary); color: var(--aura-color-primary); }
    /* Which speech detector is ACTUALLY driving the current call. */
    .vad-pill[data-kind="none"] { display: none; }
    .vad-pill[data-kind="silero"] { border-color: var(--aura-color-primary); color: var(--aura-color-primary); }
    .vad-pill[data-kind="energy"] { border-color: var(--aura-color-warning); color: var(--aura-color-warning); }
    .vad-pill[data-kind="rnnoise"] { border-color: var(--aura-color-info); color: var(--aura-color-info); }

    .cg-transcript {
      flex: 1; overflow-y: auto;
      padding: 16px; display: flex; flex-direction: column; gap: 10px;
    }
    .cg-empty { margin: auto; text-align: center; color: var(--aura-color-text-dim); max-width: 340px; }
    .cg-empty-title { font-size: 15px; margin: 0 0 6px; color: var(--aura-color-text); }
    .cg-empty-sub { font-size: 13px; margin: 0; }

    .msg-row { display: flex; }
    .msg-row[data-role="user"] { justify-content: flex-end; }
    .msg-row[data-role="model"] { justify-content: flex-start; }
    .msg-bubble {
      max-width: 78%; padding: 9px 13px; border-radius: 14px;
      font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-break: break-word;
    }
    .msg-row[data-role="user"] .msg-bubble { background: var(--aura-color-primary); color: var(--aura-color-bg); border-bottom-right-radius: 4px; }
    .msg-row[data-role="model"] .msg-bubble { background: var(--aura-color-surface-2); color: var(--aura-color-text); border-bottom-left-radius: 4px; }

    .sys-line { text-align: center; font-size: 12px; color: var(--aura-color-text-dim); }
    .sys-line[data-kind="error"] { color: var(--aura-color-danger); }

    .tool-chip {
      align-self: center; font-size: 12px;
      padding: 3px 10px; border-radius: 999px;
      background: var(--aura-color-surface); border: 1px solid var(--aura-color-border);
      color: var(--aura-color-text-dim);
    }
    .tool-chip[data-error="true"] { border-color: var(--aura-color-danger); color: var(--aura-color-danger); }

    .cg-textbar {
      display: flex; gap: 8px; padding: 8px 12px;
      border-top: 1px solid var(--aura-color-border); background: var(--aura-color-surface);
    }
    .text-input, .field-input {
      background: var(--aura-color-bg); color: var(--aura-color-text);
      border: 1px solid var(--aura-color-border); border-radius: 8px;
      padding: 8px 10px; font: inherit; font-size: 14px;
    }
    .text-input { flex: 1; }
    .text-input:focus, .field-input:focus { outline: none; border-color: var(--aura-color-primary); }

    .cg-controls {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 16px 16px; border-top: 1px solid var(--aura-color-border);
      background: var(--aura-color-surface);
    }

    .btn {
      font: inherit; font-size: 14px; font-weight: 600;
      border-radius: 10px; border: 1px solid var(--aura-color-border);
      padding: 9px 16px; cursor: pointer;
      background: var(--aura-color-surface-2); color: var(--aura-color-text);
    }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .btn-ghost { background: transparent; }
    .btn-sm { padding: 6px 10px; font-size: 13px; }
    .btn-icon { padding: 9px 12px; }
    /* Mute: icon + label; muted state is tinted so a silent mic is never missed. */
    .mute-btn { display: inline-flex; align-items: center; gap: 7px; }
    .mute-icon { display: inline-flex; }
    .mute-btn[data-muted="true"]:not(:disabled) {
      background: color-mix(in srgb, var(--aura-color-danger) 18%, transparent);
      border-color: var(--aura-color-danger); color: var(--aura-color-danger);
    }

    /* Playback volume: icon + slider + live % next to Mute. Past 100% the
       whole control tints toward warning — overdrive is a state you should
       SEE, since it means the limiter is working the signal. */
    .vol-ctl {
      display: inline-flex; align-items: center; gap: 7px;
      color: var(--aura-color-text-dim);
    }
    .vol-icon { display: inline-flex; }
    /* Speaker icon = one-click silence toggle. */
    .vol-mute-btn {
      background: transparent; border: 0; padding: 2px; margin: 0;
      color: inherit; cursor: pointer; border-radius: 6px;
    }
    .vol-mute-btn:hover { color: var(--aura-color-text); }
    .vol-mute-btn:focus-visible { outline: 2px solid var(--aura-color-primary); outline-offset: 1px; }
    .vol-slider {
      width: 90px; margin: 0;
      accent-color: var(--aura-color-primary);
    }
    .vol-val {
      font-size: 12px; font-variant-numeric: tabular-nums;
      min-width: 4ch; text-align: right;
    }
    .vol-ctl[data-overdrive="true"] {
      color: var(--aura-color-warning);
    }
    .vol-ctl[data-overdrive="true"] .vol-slider {
      accent-color: var(--aura-color-warning);
    }
    /* Silenced wins over overdrive: a mute you can't see is a bug report. */
    .vol-ctl[data-muted="true"],
    .vol-ctl[data-muted="true"] .vol-mute-btn { color: var(--aura-color-danger); }
    .vol-ctl[data-muted="true"] .vol-slider { opacity: 0.5; accent-color: var(--aura-color-danger); }

    .call-btn {
      flex: 1; background: var(--aura-color-primary); color: var(--aura-color-bg);
      border-color: transparent; font-size: 15px; padding: 11px 16px;
      /* Audio mirror: --cg-level (0..1, set per animation frame from real
         mic/playback RMS) gently scales + glows the button. transform and
         box-shadow don't reflow, so the layout never shifts. */
      transform: scale(calc(1 + var(--cg-level, 0) * 0.07));
      box-shadow: 0 0 calc(var(--cg-level, 0) * 24px)
        color-mix(in srgb, var(--aura-color-primary) 55%, transparent);
      will-change: transform, box-shadow;
    }
    .call-btn[data-active="true"] { background: var(--aura-color-danger); }
    .call-btn[data-voice="model"] {
      box-shadow: 0 0 calc(var(--cg-level, 0) * 24px)
        color-mix(in srgb, var(--aura-color-info) 60%, transparent);
    }

    /* ── Settings view (full-window page over the chat) ─────────────────
       The chat stays mounted underneath (call audio + WS keep running);
       `visibility` hides it and takes it out of the tab order. */
    .cg-settings {
      position: absolute; inset: 0; z-index: 40;
      display: none; flex-direction: column;
      background: var(--aura-color-bg); color: var(--aura-color-text);
    }
    .cg-app[data-view="settings"] .cg-settings { display: flex; }
    .cg-app[data-view="settings"] > :not(.cg-settings) { visibility: hidden; }
    .settings-head {
      display: flex; align-items: center; gap: 10px; flex: 0 0 auto;
      padding: 10px 14px; border-bottom: 1px solid var(--aura-color-border);
    }
    .settings-title { margin: 0; font-size: 16px; flex: 1; }
    /* Only worth showing while a call is up ("Idle" is noise here). */
    .settings-head .status-pill[data-state="idle"] { display: none; }
    .settings-body { flex: 1 1 auto; overflow-y: auto; padding: 16px 18px 20px; }

    /* Profile bar: which AI setup the tabs below edit. */
    .settings-profilebar {
      display: flex; align-items: center; gap: 8px; flex: 0 0 auto;
      padding: 10px 14px; background: var(--aura-color-surface);
      border-bottom: 1px solid var(--aura-color-border);
    }
    .profilebar-label { font-size: 12px; font-weight: 700; color: var(--aura-color-text-dim); }
    .profile-select { flex: 1; min-width: 0; font-weight: 600; }
    /* Global settings are not per profile — dim the profile bar on that tab. */
    .cg-settings[data-tab="global"] .settings-profilebar { opacity: 0.55; }

    /* ⋯ menus */
    .menu-anchor { position: relative; flex: 0 0 auto; }
    .settings-menu {
      display: none; position: absolute; top: calc(100% + 4px); right: 0; z-index: 10;
      min-width: 160px; padding: 4px; flex-direction: column;
      background: var(--aura-color-surface-2); border: 1px solid var(--aura-color-border);
      border-radius: 10px; box-shadow: var(--aura-glow-subtle);
    }
    .settings-menu[data-open="true"] { display: flex; }
    .menu-item {
      font: inherit; font-size: 13px; text-align: left; cursor: pointer;
      padding: 7px 10px; border: none; border-radius: 6px;
      background: transparent; color: var(--aura-color-text);
    }
    .menu-item:hover:not(:disabled), .menu-item:focus-visible { background: var(--aura-color-surface); }
    .menu-item:disabled { opacity: 0.45; cursor: default; }
    .menu-item-danger { color: var(--aura-color-danger); }

    /* Inline rename / delete-confirm bar (iframes may block prompt()/confirm()). */
    .inline-bar {
      display: none; align-items: center; gap: 8px; flex-wrap: wrap;
      padding: 8px 14px; background: var(--aura-color-surface-2);
      border-bottom: 1px solid var(--aura-color-border);
    }
    .inline-bar:not([data-mode="none"]) { display: flex; }
    .inline-bar-msg { font-size: 13px; font-weight: 600; }
    .inline-bar-input { flex: 1; min-width: 120px; display: none; }
    .inline-bar[data-mode="rename"] .inline-bar-input { display: block; }
    .inline-bar[data-mode="confirm"] .inline-bar-msg { flex: 1; }
    .inline-bar-ok { background: var(--aura-color-primary); color: var(--aura-color-bg); border-color: transparent; }
    .inline-bar-ok[data-danger="true"] { background: var(--aura-color-danger); }
    .roles-editor .inline-bar { border: 1px solid var(--aura-color-border); border-radius: 10px; margin-bottom: 12px; }

    /* Tabs: profile sections | divider | Global. */
    .settings-tabs {
      display: flex; align-items: stretch; gap: 2px; flex: 0 0 auto;
      padding: 0 10px; overflow-x: auto; scrollbar-width: none;
      border-bottom: 1px solid var(--aura-color-border);
    }
    .settings-tab {
      font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap;
      padding: 10px 10px 8px; border: none; border-bottom: 2px solid transparent;
      background: transparent; color: var(--aura-color-text-dim);
    }
    .settings-tab:hover { color: var(--aura-color-text); }
    .settings-tab[aria-selected="true"] { color: var(--aura-color-primary); border-bottom-color: var(--aura-color-primary); }
    .settings-tabs-sep { flex: 0 0 1px; margin: 9px 6px; background: var(--aura-color-border); }
    .settings-panel { display: none; flex-direction: column; gap: 14px; }
    .settings-panel[data-active="true"] { display: flex; }
    .panel-note { margin: 0; font-size: 12px; color: var(--aura-color-text-dim); }

    .badge {
      font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px; white-space: nowrap;
      border: 1px solid var(--aura-color-border); color: var(--aura-color-text-dim);
    }
    .badge-on, .badge[data-state="editable"] { background: var(--aura-color-success); color: var(--aura-color-bg); border-color: transparent; }
    .badge[data-state="frozen"] { background: var(--aura-color-surface-2); }

    /* Roles: select on narrow windows, a side list from 720px. */
    .roles-layout { display: flex; flex-direction: column; gap: 14px; }
    .roles-toolbar { display: flex; gap: 8px; align-items: center; }
    .role-select { flex: 1; min-width: 0; }
    .roles-toolbar .btn { display: inline-flex; align-items: center; gap: 4px; flex: 0 0 auto; }
    .roles-list { display: none; }
    .roles-editor { flex: 1; min-width: 0; }
    .role-empty, .role-card { display: none; }
    .role-empty[data-show="true"] {
      display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
      padding: 16px; border: 1px dashed var(--aura-color-border); border-radius: 12px;
      color: var(--aura-color-text-dim); font-size: 13px;
    }
    .role-empty p { margin: 0; }
    .role-empty .btn { display: inline-flex; align-items: center; gap: 4px; }
    .role-card[data-show="true"] {
      display: flex; flex-direction: column; gap: 12px;
      padding: 14px; border: 1px solid var(--aura-color-border); border-radius: 12px;
      background: var(--aura-color-surface);
    }
    .role-card-head { display: flex; align-items: center; gap: 8px; }
    .role-name { font-size: 15px; font-weight: 700; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    [data-role="role-active-badge"][data-show="false"],
    [data-action="role-activate"][data-show="false"] { display: none; }
    .version-row { display: flex; align-items: flex-end; gap: 8px; flex-wrap: wrap; }
    .version-pick { display: flex; flex-direction: column; gap: 4px; }
    .version-select { min-width: 120px; }
    .version-row .badge { margin-bottom: 8px; }
    .version-actions { display: flex; gap: 6px; margin-left: auto; }
    .version-actions .btn { display: inline-flex; align-items: center; gap: 4px; }
    .role-text { min-height: 200px; resize: vertical; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; line-height: 1.5; }
    .role-text[readonly] { opacity: 0.75; cursor: default; }

    @media (min-width: 720px) {
      .roles-layout { flex-direction: row; align-items: flex-start; }
      .roles-nav { flex: 0 0 200px; display: flex; flex-direction: column; gap: 8px; }
      .role-select { display: none; }
      .roles-toolbar { justify-content: flex-end; }
      .roles-list { display: flex; flex-direction: column; gap: 4px; }
      .roles-list-item {
        font: inherit; text-align: left; cursor: pointer;
        display: flex; flex-direction: column; gap: 2px;
        padding: 8px 10px; border-radius: 8px; border: 1px solid transparent;
        background: transparent; color: var(--aura-color-text);
      }
      .roles-list-item:hover { background: var(--aura-color-surface-2); }
      .roles-list-item[data-selected="true"] { background: var(--aura-color-surface-2); border-color: var(--aura-color-primary); }
      .roles-list-name { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .roles-list-meta { font-size: 11px; color: var(--aura-color-text-dim); }
      .roles-list-item[data-active="true"] .roles-list-meta { color: var(--aura-color-success); }
    }
    .settings-foot {
      display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex: 0 0 auto;
      padding: 10px 14px; border-top: 1px solid var(--aura-color-border);
      background: var(--aura-color-surface);
    }
    .settings-foot .call-btn { flex: 0 0 auto; }
    .settings-foot-msg { flex: 1; font-size: 13px; font-weight: 600; }
    /* Normal mode: Cancel + Save. Confirm mode: message + Keep editing + Discard. */
    .settings-foot-msg,
    .settings-foot [data-action="settings-keep"],
    .settings-foot [data-action="settings-discard"] { display: none; }
    .settings-foot[data-confirm="true"] .settings-foot-msg,
    .settings-foot[data-confirm="true"] [data-action="settings-keep"],
    .settings-foot[data-confirm="true"] [data-action="settings-discard"] { display: inline-flex; }
    .settings-foot[data-confirm="true"] [data-action="settings-close"],
    .settings-foot[data-confirm="true"] [data-action="settings-save"] { display: none; }
    .btn-danger { background: var(--aura-color-danger); color: var(--aura-color-bg); border-color: transparent; }

    .field { display: flex; flex-direction: column; gap: 6px; }
    .field-label { font-size: 12px; font-weight: 600; color: var(--aura-color-text-dim); }
    .field-hint { font-size: 11px; color: var(--aura-color-text-dim); }
    textarea.field-input { resize: vertical; }
    /* Custom model id input: only shown when the Model preset is "Custom…". */
    .model-custom { display: none; }
    .field[data-custom="true"] .model-custom { display: block; }

    /* Languages multi-select chips (toggle). */
    .lang-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .lang-chip {
      font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
      padding: 5px 11px; border-radius: 999px;
      background: var(--aura-color-surface-2); color: var(--aura-color-text);
      border: 1px solid var(--aura-color-border);
    }
    .lang-chip[data-on="true"] { background: var(--aura-color-primary); color: var(--aura-color-bg); border-color: transparent; }

    .mcp-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 6px; }
    .mcp-row { display: flex; gap: 6px; align-items: center; }
    .mcp-url { flex: 1; }
    .mcp-transport, .mcp-behavior { flex: 0 0 auto; }
    .btn-del {
      font: inherit; font-size: 12px; font-weight: 600; cursor: pointer;
      padding: 6px 10px; border-radius: 8px;
      background: transparent; color: var(--aura-color-danger);
      border: 1px solid var(--aura-color-border);
    }
  </style>
</body>
